{"titulo": "🚤 Submarino", "html": "<style>*{-webkit-tap-highlight-color:transparent;-webkit-user-select:none;user-select:none;-webkit-touch-callout:none;box-sizing:border-box;margin:0}\nhtml,body{overscroll-behavior:none;-webkit-overflow-scrolling:auto}\nbody{background:transparent;font-family:-apple-system,'Segoe UI',Roboto,Arial,sans-serif;color:#e8edf0}\n.wrap{width:100%;max-width:620px;margin:auto;padding:12px}\n.card{background:rgba(20,25,29,.985);border:1px solid rgba(255,255,255,.13);border-radius:16px;overflow:hidden;box-shadow:0 8px 34px rgba(0,0,0,.45)}\n.head{padding:10px 14px;border-bottom:1px solid rgba(255,255,255,.09);display:flex;justify-content:space-between;align-items:center;gap:10px}\n.brand{font-size:9px;letter-spacing:1.7px;color:rgba(255,255,255,.34)}\n.title{font-size:17px;font-weight:900;color:#fff;line-height:1.2}\n.hud{display:flex;gap:13px;text-align:right;flex-shrink:0}\n.lab{font-size:8px;letter-spacing:1px;color:rgba(255,255,255,.42)}\n.val{font:800 16px ui-monospace,'Courier New',monospace;color:#ffd479;white-space:nowrap}\n.main{padding:12px}\n.stage{position:relative;touch-action:none;-ms-touch-action:none}\ncanvas{display:block;width:100%;height:auto;background:#080b0d;border:1px solid rgba(255,255,255,.1);border-radius:12px;touch-action:none}\n#board{touch-action:none}\n.msg{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6px;background:rgba(5,8,10,.86);border-radius:12px;text-align:center;padding:16px}\n.msg.off{display:none}\n.msg b{font-size:19px;color:#fff;letter-spacing:.5px}\n.msg span{font-size:12px;color:rgba(255,255,255,.62);line-height:1.5;max-width:88%}\n.deck{margin-top:11px;display:flex;justify-content:space-between;align-items:center;gap:12px;touch-action:none}\n.dpad{display:grid;grid-template-columns:repeat(3,44px);grid-template-rows:repeat(3,44px);gap:5px;flex-shrink:0}\n.dpad.h{grid-template-rows:44px}\n.dpad.v{grid-template-columns:44px}\n.k{border:1px solid rgba(255,255,255,.17);background:rgba(255,255,255,.085);color:#fff;border-radius:12px;font:800 16px system-ui;display:flex;align-items:center;justify-content:center;touch-action:none;padding:0;line-height:1;transition:transform .05s,background .05s}\n.k.on{background:rgba(255,255,255,.3);transform:scale(.93)}\n.k.sp{visibility:hidden}\n.acts{display:flex;gap:9px;align-items:center;flex-wrap:wrap;justify-content:flex-end}\n.k.rd{width:62px;height:62px;border-radius:50%;font-size:15px;flex-direction:column;gap:1px}\n.k.rd small{font-size:7px;letter-spacing:.6px;opacity:.75;font-weight:700}\n.k.a{background:#d8394f;border-color:#ff7f92}\n.k.b{background:#2f6fe4;border-color:#79a5ff}\n.k.c{background:#1f9d63;border-color:#67d9a0}\n.k.d{background:#8a52d6;border-color:#b892f0}\n.pills{display:flex;gap:8px;justify-content:center;margin-top:10px;flex-wrap:wrap}\n.k.pill{padding:10px 18px;border-radius:20px;font:800 11px system-ui;letter-spacing:1.2px;min-width:78px}\n.hint{text-align:center;margin-top:9px;font-size:11px;color:rgba(255,255,255,.48);line-height:1.45}\n.grid{display:grid;gap:5px;touch-action:none}\n.cell{border:1px solid rgba(255,255,255,.12);background:rgba(255,255,255,.05);border-radius:8px;display:flex;align-items:center;justify-content:center;font-weight:800;touch-action:none}</style><body><script>var HZ=(function(){\nvar api={},C={},cv,cx,msg,hudEl,parts=[],shakeN=0,vinh=null,held={},tap={},press={},W=0,H=0,tickFn=null,raf=0,prev=0,ac=null,paused=1;\nfunction el(t,c,h){var e=document.createElement(t);if(c)e.className=c;if(h!=null)e.innerHTML=h;return e}\nfunction key(id,cls,label,sub){\n  var b=el('button','k '+cls,label+(sub?'<small>'+sub+'</small>':''));\n  b.setAttribute('type','button');\n  // Deixa o id do botao legivel de fora: a auditoria cruza isto com os\n  // `HZ.on`/`HZ.held` do jogo para achar entrada que nunca dispara.\n  b.dataset.hz=id;\n  // Trava de rolagem: sem preventDefault no pointerdown o webview do WhatsApp\n  // interpreta o arrasto no botao como scroll do chat e o jogo fica injogavel.\n  b.addEventListener('pointerdown',function(e){e.preventDefault();e.stopPropagation();hold(id,1);b.classList.add('on')});\n  var up=function(e){if(e)e.preventDefault();hold(id,0);b.classList.remove('on')};\n  b.addEventListener('pointerup',up);b.addEventListener('pointercancel',up);b.addEventListener('pointerleave',up);\n  b.addEventListener('contextmenu',function(e){e.preventDefault()});\n  return b;\n}\nfunction hold(id,v){\n  if(v){if(!held[id]){tap[id]=1;if(press[id])press[id]()}held[id]=1}else held[id]=0;\n}\nvar ARROW={U:'&#9650;',D:'&#9660;',L:'&#9664;',R:'&#9654;'};\nfunction pad(kind){\n  var d=el('div','dpad'+(kind=='h'?' h':kind=='v'?' v':''));\n  var slots=kind=='h'?['L','R']:kind=='v'?['U','D']:['sp','U','sp','L','sp','R','sp','D','sp'];\n  slots.forEach(function(s){ d.appendChild(s=='sp'?el('button','k sp',''):key(s,'',ARROW[s])); });\n  return d;\n}\nfunction boot(cfg){\n  C=cfg;\n  var wrap=el('div','wrap'),card=el('div','card');\n  var head=el('div','head');\n  head.appendChild(el('div','','<div class=\"brand\">HIURA ARCADE</div><div class=\"title\">'+cfg.titulo+'</div>'));\n  hudEl=el('div','hud');\n  (cfg.hud||[]).forEach(function(l){hudEl.appendChild(el('div','','<div class=\"lab\">'+l+'</div><div class=\"val\" id=\"hv'+l+'\">0</div>'))});\n  head.appendChild(hudEl);card.appendChild(head);\n  var main=el('div','main'),stage=el('div','stage');\n  if(cfg.dom){var bd=el('div','',' ');bd.id='board';stage.appendChild(bd)}\n  else{cv=el('canvas');cv.id='cv';cv.width=W=cfg.w||360;cv.height=H=cfg.h||300;stage.appendChild(cv);cx=cv.getContext('2d')}\n  msg=el('div','msg');stage.appendChild(msg);main.appendChild(stage);\n  if(cfg.pad||cfg.acts){\n    var deck=el('div','deck');\n    deck.appendChild(cfg.pad?pad(cfg.pad):el('div','',''));\n    var acts=el('div','acts');\n    (cfg.acts||[]).forEach(function(a,i){acts.appendChild(key(a[0],'rd '+'abcd'[i],a[1],a[2]))});\n    deck.appendChild(acts);main.appendChild(deck);\n  }\n  if(cfg.pills){var p=el('div','pills');cfg.pills.forEach(function(a){p.appendChild(key(a[0],'pill',a[1]))});main.appendChild(p)}\n  if(cfg.hint)main.appendChild(el('div','hint',cfg.hint));\n  card.appendChild(main);wrap.appendChild(card);document.body.appendChild(wrap);\n  // Segunda camada da trava: navegadores antigos ignoram touch-action.\n  stage.addEventListener('touchmove',function(e){e.preventDefault()},{passive:false});\n  document.querySelectorAll('.deck,.pills').forEach(function(n){\n    n.addEventListener('touchmove',function(e){e.preventDefault()},{passive:false})});\n  if(cfg.keys!==false)document.addEventListener('keydown',function(e){\n    var m={ArrowUp:'U',ArrowDown:'D',ArrowLeft:'L',ArrowRight:'R',KeyW:'U',KeyS:'D',KeyA:'L',KeyD:'R',Space:'A',KeyZ:'A',KeyX:'B',Enter:'START'};\n    if(m[e.code]){e.preventDefault();hold(m[e.code],1)}});\n  if(cfg.keys!==false)document.addEventListener('keyup',function(e){\n    var m={ArrowUp:'U',ArrowDown:'D',ArrowLeft:'L',ArrowRight:'R',KeyW:'U',KeyS:'D',KeyA:'L',KeyD:'R',Space:'A',KeyZ:'A',KeyX:'B',Enter:'START'};\n    if(m[e.code])hold(m[e.code],0)});\n  if(cfg.best)api.best=+(load(cfg.best)||0),api.hud(cfg.hud&&cfg.hud[cfg.hud.length-1]||'BEST',api.best);\n  return api;\n}\nfunction load(k){try{return localStorage.getItem('hz_'+k)}catch(e){return null}}\nfunction save(k,v){try{localStorage.setItem('hz_'+k,v)}catch(e){}}\napi.boot=boot;\napi.hud=function(l,v){var e=document.getElementById('hv'+l);if(e)e.textContent=v};\napi.best=0;\napi.record=function(v){if(v>api.best){api.best=v;if(C.best)save(C.best,v);\n api.hud(C.hud&&C.hud[C.hud.length-1]||'BEST',v);\n if(cx)api.part(W-40,14,'#ffd479',8,2.2);\n return 1}return 0};\napi.held=function(k){return !!held[k]};\napi.tap=function(k){var v=tap[k];tap[k]=0;return !!v};\napi.on=function(k,f){press[k]=f};\napi.over=function(t,s,btn){paused=1;api.shake(9);msg.className='msg';msg.innerHTML='<b>'+t+'</b>'+(s?'<span>'+s+'</span>':'');\n  if(btn!==false){var b=el('button','k pill',btn||'JOGAR');b.style.marginTop='10px';\n    b.addEventListener('pointerdown',function(e){e.preventDefault();if(C.start)C.start()});msg.appendChild(b)}};\napi.play=function(){msg.className='msg off';paused=0};\napi.paused=function(){return paused};\napi.loop=function(f){tickFn=f;if(!raf){prev=0;raf=requestAnimationFrame(step)}};\n// Tremida vai no `transform` do CANVAS, nao no contexto: transladar o contexto\n// deixaria uma faixa vazia na borda em todo jogo que pinta o fundo com\n// `fillRect(0,0,W,H)` em vez do `HZ.clear`.\napi.shake=function(n){shakeN=Math.max(shakeN,n||7)};\napi.part=function(x,y,c,n,v){\n for(var i=0;i<(n||10);i++){var a=Math.random()*6.2832,s=(v||2.4)*(.35+Math.random());\n  parts.push({x:x,y:y,vx:Math.cos(a)*s,vy:Math.sin(a)*s-.6,c:c||'#fff',t:1,r:1.4+Math.random()*2.2})}};\nfunction step(t){raf=requestAnimationFrame(step);\n var ms=prev?Math.min(50,t-prev):16;prev=t;var d=ms/16.667;\n if(tickFn)tickFn(d,t);\n if(cx){if(!vinh){vinh=cx.createRadialGradient(W/2,H*.45,Math.min(W,H)*.3,W/2,H*.5,Math.max(W,H)*.75);\n   vinh.addColorStop(0,'rgba(0,0,0,0)');vinh.addColorStop(.65,'rgba(0,0,0,.1)');\n   vinh.addColorStop(1,'rgba(0,0,0,.34)')}\n  cx.fillStyle=vinh;cx.fillRect(0,0,W,H)}\n if(cx&&parts.length)parts=parts.filter(function(p){\n  p.x+=p.vx*d;p.y+=p.vy*d;p.vy+=.14*d;p.t-=.028*d;\n  if(p.t<=0)return 0;\n  cx.globalAlpha=Math.min(1,p.t);cx.fillStyle=p.c;\n  cx.fillRect(p.x-p.r,p.y-p.r,p.r*2,p.r*2);cx.globalAlpha=1;return 1});\n if(shakeN>.4){shakeN*=.86;\n  if(cv)cv.style.transform='translate('+((Math.random()-.5)*shakeN).toFixed(1)+'px,'\n   +((Math.random()-.5)*shakeN).toFixed(1)+'px)'}\n else if(shakeN){shakeN=0;if(cv)cv.style.transform=''}}\napi.beep=function(f,d,type){\n  try{if(!ac)ac=new (window.AudioContext||window.webkitAudioContext)();\n  var o=ac.createOscillator(),g=ac.createGain();o.type=type||'square';o.frequency.value=f;\n  g.gain.value=.05;o.connect(g);g.connect(ac.destination);o.start();\n  g.gain.exponentialRampToValueAtTime(.001,ac.currentTime+(d||.08));o.stop(ac.currentTime+(d||.08))}catch(e){}};\nObject.defineProperty(api,'cx',{get:function(){return cx}});\nObject.defineProperty(api,'cv',{get:function(){return cv}});\nObject.defineProperty(api,'W',{get:function(){return W}});\nObject.defineProperty(api,'H',{get:function(){return H}});\n// Escurece uma cor #rrggbb por um fator. Serve para derivar o pé do gradiente\n// do fundo a partir da única cor que o jogo informa.\nfunction escuro(c,f){\n if(!/^#[0-9a-fA-F]{6}$/.test(c))return c;\n var n=parseInt(c.slice(1),16);\n return '#'+[16,8,0].map(function(s){\n  return ('0'+Math.round(((n>>s)&255)*(1-f)).toString(16)).slice(-2)}).join('')}\n// `clear` deixou de ser cor chapada: o fundo desce para uma versão mais escura\n// de si mesmo. Um jogo que só passa uma cor ganha profundidade sem saber.\napi.clear=function(c){c=c||'#080b0d';\n var g=cx.createLinearGradient(0,0,0,H);\n g.addColorStop(0,c);g.addColorStop(1,escuro(c,.42));\n cx.fillStyle=g;cx.fillRect(0,0,W,H)};\n// Chanfro de 1px em cima e embaixo: é como pixel art sombreia, e cai bem tanto\n// em tijolo e plataforma quanto em barra de HUD.\napi.box=function(x,y,w,h,c){cx.fillStyle=c;cx.fillRect(x,y,w,h);\n if(w>3&&h>3){cx.fillStyle='rgba(255,255,255,.14)';cx.fillRect(x,y,w,1);\n  cx.fillStyle='rgba(0,0,0,.2)';cx.fillRect(x,y+h-1,w,1)}};\n// Pixel art a partir de um mapa de texto: cada caractere é um pixel, '.' é\n// vazio. É assim que os originais são desenhados, e cabe em poucas linhas —\n// desenhar o invasor com retângulo solto é o que faz parecer imitação.\napi.sprite=function(x,y,s,mapa,cores){\n for(var r=0;r<mapa.length;r++){var lin=mapa[r];\n  for(var c=0;c<lin.length;c++){var k=lin.charAt(c);\n   if(k==='.'||k===' ')continue;\n   cx.fillStyle=cores[k]||cores['X']||'#fff';\n   cx.fillRect(x+c*s,y+r*s,s,s)}}};\n// Vidas: 11 jogos escreviam ❤️, que e emoji com seletor de variacao — em parte\n// dos aparelhos sai como glifo de TEXTO (preto e chapado) e em outros nem sai.\n// Quantas vidas restam nao pode depender da fonte do celular.\nvar CORACAO=[\".XX.XX.\",\"XXXXXXX\",\"XXXXXXX\",\"XXXXXXX\",\".XXXXX.\",\"..XXX..\",\"...X...\"];\napi.vidas=function(n,x,y,c,s){s=s||2;\n for(var i=0;i<n;i++)api.sprite(x+i*(7*s+3),y,s,CORACAO,{X:c||'#ff4757'})};\napi.txt=function(s,x,y,c,sz,al){cx.fillStyle=c||'#fff';cx.font='800 '+(sz||14)+'px system-ui';cx.textAlign=al||'center';cx.fillText(s,x,y);cx.textAlign='left'};\n// Brilho no alto à esquerda transforma o disco chapado em esfera. Vale para\n// bola, inimigo, moeda — tudo que os jogos desenham com `circ`.\napi.circ=function(x,y,r,c){cx.fillStyle=c;cx.beginPath();cx.arc(x,y,r,0,6.284);cx.fill();\n if(r>3.5){var g=cx.createRadialGradient(x-r*.34,y-r*.34,r*.08,x,y,r);\n  g.addColorStop(0,'rgba(255,255,255,.3)');g.addColorStop(.55,'rgba(255,255,255,.06)');\n  g.addColorStop(1,'rgba(0,0,0,.16)');\n  cx.fillStyle=g;cx.beginPath();cx.arc(x,y,r,0,6.284);cx.fill()}};\n// Toque direto na tela do jogo (mira, seleção): devolve coordenadas do canvas.\napi.touch=function(f){var t=C.dom?document.getElementById('board'):cv;\n  t.addEventListener('pointerdown',function(e){e.preventDefault();\n    var r=t.getBoundingClientRect();f((e.clientX-r.left)/r.width*W,(e.clientY-r.top)/r.height*H,e)})};\napi.load=load;api.save=save;\napi.rnd=function(n){return Math.random()*n};\napi.ri=function(n){return Math.floor(Math.random()*n)};\nreturn api;})();\nvar s,torp,cargas,navios,pts,vidas,fase,ar,prof;\nHZ.boot({titulo:\"🚤 Submarino\",w:340,h:320,best:\"submarino\",hud:[\"PONTOS\",\"RECORDE\"],pad:\"4\",\n acts:[[\"A\",\"🚀\",\"TORPEDO\"]],pills:[[\"START\",\"REINICIAR\"]],\n hint:\"Setas navegam · A dispara para cima · o ar acaba mais rápido no fundo — suba para respirar\",start:novo});\nfunction novo(){pts=0;vidas=3;fase=1;ar=100;\n // `prof` so e calculada dentro do `if(!paused)`, mas a barra e desenhada\n // sempre — e o jogo comeca pausado na tela inicial. Sem este valor a\n // altura da barra saia NaN no primeiro quadro.\n prof=0;\n s={x:80,y:180,vx:0,vy:0,inv:0,cd:0};torp=[];cargas=[];navios=[];\n for(var i=0;i<3;i++)poe();HZ.hud(\"PONTOS\",0);HZ.play()}\nfunction poe(){var t=HZ.ri(3);\n navios.push({x:HZ.rnd(340),y:44,v:(HZ.rnd(1)<.5?-1:1)*(.6+HZ.rnd(.9)+fase*.14),\n  hp:t+1,w:34+t*16,t:t,cd:60+HZ.ri(90)})}\nHZ.on(\"START\",novo);\nHZ.on(\"A\",function(){if(HZ.paused()||s.cd>0)return;s.cd=34;\n torp.push({x:s.x,y:s.y-10,v:-4.4});HZ.beep(700,.06)});\nHZ.loop(function(dt){var W=HZ.W,H=HZ.H;\n var g=HZ.cx.createLinearGradient(0,0,0,H);\n g.addColorStop(0,\"#7fc7e8\");g.addColorStop(.16,\"#1a6fa8\");g.addColorStop(1,\"#052236\");\n HZ.cx.fillStyle=g;HZ.cx.fillRect(0,0,W,H);\n HZ.box(0,56,W,3,\"rgba(255,255,255,.25)\");\n if(!HZ.paused()){\n  if(s.cd>0)s.cd-=dt;if(s.inv>0)s.inv-=dt;\n  if(HZ.held(\"U\"))s.vy-=.34*dt;if(HZ.held(\"D\"))s.vy+=.34*dt;\n  if(HZ.held(\"L\"))s.vx-=.34*dt;if(HZ.held(\"R\"))s.vx+=.34*dt;\n  s.vx*=Math.pow(.9,dt);s.vy*=Math.pow(.9,dt);\n  s.x+=s.vx*dt;s.y+=s.vy*dt;\n  s.x=Math.max(18,Math.min(W-18,s.x));s.y=Math.max(64,Math.min(H-16,s.y));\n  prof=Math.max(0,(s.y-78)/226);\n  // Fundo consome mais ar: dá motivo para subir mesmo com fôlego sobrando.\n  if(s.y<78){ar=Math.min(100,ar+.7*dt)}else ar-=(.04+prof*.075)*dt;\n  if(ar<=0){vidas--;ar=100;s.y=100;HZ.beep(120,.4,\"sawtooth\");\n   if(vidas<=0){HZ.record(pts);HZ.over(\"SEM AR\",\"Fase \"+fase+\" · \"+pts+\" pontos\")}}\n  navios.forEach(function(n){n.x+=n.v*dt;\n   if(n.x<-n.w)n.x=W+n.w;if(n.x>W+n.w)n.x=-n.w;\n   n.cd-=dt;\n   if(n.cd<=0&&Math.abs(n.x-s.x)<110){n.cd=90+HZ.ri(110)-fase*8;\n    cargas.push({x:n.x,y:58,v:1.3+fase*.12})}});\n  torp=torp.filter(function(t){t.y+=t.v*dt;\n   for(var i=0;i<navios.length;i++){var n=navios[i];\n    if(t.y<62&&Math.abs(t.x-n.x)<n.w/2){\n     n.hp--;HZ.beep(600,.07);\n     if(n.hp<=0){pts+=(n.t+1)*50*fase;HZ.hud(\"PONTOS\",pts);HZ.record(pts);\n      navios.splice(i,1);HZ.beep(1300,.2);\n      if(!navios.length){fase++;for(var k=0;k<2+fase;k++)poe();HZ.beep(1600,.3)}}\n     return 0}}\n   return t.y>50});\n  cargas=cargas.filter(function(c){c.y+=c.v*dt;\n   if(s.inv<=0&&Math.hypot(c.x-s.x,c.y-s.y)<17){\n    vidas--;s.inv=110;HZ.beep(130,.35,\"sawtooth\");\n    if(vidas<=0){HZ.record(pts);HZ.over(\"SUBMARINO AFUNDADO\",\"Fase \"+fase+\" · \"+pts+\" pontos\")}\n    return 0}\n   return c.y<H});\n }\n var NC=[\"#7f8c8d\",\"#c0392b\",\"#2c3e50\"];\n navios.forEach(function(n){\n  HZ.cx.fillStyle=NC[n.t];HZ.cx.beginPath();\n  HZ.cx.moveTo(n.x-n.w/2,38);HZ.cx.lineTo(n.x+n.w/2,38);\n  HZ.cx.lineTo(n.x+n.w/2-7,56);HZ.cx.lineTo(n.x-n.w/2+7,56);HZ.cx.fill();\n  HZ.box(n.x-8,24,16,14,\"#95a5a6\");HZ.box(n.x-2,12,4,12,\"#7f8c8d\");\n  for(var k=0;k<n.hp;k++)HZ.box(n.x-n.hp*4+k*8,8,6,3,\"#2ed573\")});\n cargas.forEach(function(c){HZ.circ(c.x,c.y,6,\"#2d3436\");HZ.box(c.x-2,c.y-9,4,5,\"#95a5a6\")});\n torp.forEach(function(t){HZ.box(t.x-2,t.y,4,12,\"#ffd479\");\n  HZ.circ(t.x,t.y,2.4,\"#fff\")});\n if(s.inv<=0||Math.floor(Date.now()/90)%2){\n  HZ.cx.fillStyle=\"#f1c40f\";HZ.cx.beginPath();\n  HZ.cx.ellipse(s.x,s.y,20,9,0,0,6.284);HZ.cx.fill();\n  HZ.box(s.x-5,s.y-15,10,7,\"#f1c40f\");HZ.box(s.x-1,s.y-21,2,7,\"#f1c40f\");\n  HZ.circ(s.x+8,s.y-1,3.4,\"#7ee8fa\");HZ.circ(s.x-1,s.y-1,3.4,\"#7ee8fa\")}\n HZ.box(12,H-16,110,9,\"rgba(0,0,0,.4)\");HZ.box(12,H-16,ar/100*110,9,ar<30?\"#ff4757\":\"#7ee8fa\");\n HZ.txt(\"AR\",67,H-9,\"#fff\",8);\n HZ.box(W-92,18,10,120,\"rgba(0,0,0,.35)\");\n HZ.box(W-92,18,10,prof*120,prof>.7?\"#ff6b81\":\"#7ee8fa\");\n HZ.txt(\"PROF\",W-87,150,\"rgba(255,255,255,.55)\",8);\n HZ.vidas(vidas,W-25-(vidas-1)*17,H-21,\"#7ee8fa\");\n HZ.txt(\"FASE \"+fase,W/2,H-8,\"rgba(255,255,255,.65)\",11);\n});\nnovo();HZ.over(\"SUBMARINO\",\"Afunde os navios de cima com torpedos e desvie das cargas de profundidade.\\nO ar acaba — subir perto da superfície reabastece.\");\n</script></body>"}