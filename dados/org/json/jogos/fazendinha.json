{"titulo": "🌾 Fazendinha", "html": "<style>*{-webkit-tap-highlight-color:transparent;-webkit-user-select:none;user-select:none;-webkit-touch-callout:none;box-sizing:border-box;margin:0}\nhtml,body{overscroll-behavior:none;-webkit-overflow-scrolling:auto}\nbody{background:transparent;font-family:-apple-system,'Segoe UI',Roboto,Arial,sans-serif;color:#e8edf0}\n.wrap{width:100%;max-width:620px;margin:auto;padding:12px}\n.card{background:rgba(20,25,29,.985);border:1px solid rgba(255,255,255,.13);border-radius:16px;overflow:hidden;box-shadow:0 8px 34px rgba(0,0,0,.45)}\n.head{padding:10px 14px;border-bottom:1px solid rgba(255,255,255,.09);display:flex;justify-content:space-between;align-items:center;gap:10px}\n.brand{font-size:9px;letter-spacing:1.7px;color:rgba(255,255,255,.34)}\n.title{font-size:17px;font-weight:900;color:#fff;line-height:1.2}\n.hud{display:flex;gap:13px;text-align:right;flex-shrink:0}\n.lab{font-size:8px;letter-spacing:1px;color:rgba(255,255,255,.42)}\n.val{font:800 16px ui-monospace,'Courier New',monospace;color:#ffd479;white-space:nowrap}\n.main{padding:12px}\n.stage{position:relative;touch-action:none;-ms-touch-action:none}\ncanvas{display:block;width:100%;height:auto;background:#080b0d;border:1px solid rgba(255,255,255,.1);border-radius:12px;touch-action:none}\n#board{touch-action:none}\n.msg{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6px;background:rgba(5,8,10,.86);border-radius:12px;text-align:center;padding:16px}\n.msg.off{display:none}\n.msg b{font-size:19px;color:#fff;letter-spacing:.5px}\n.msg span{font-size:12px;color:rgba(255,255,255,.62);line-height:1.5;max-width:88%}\n.deck{margin-top:11px;display:flex;justify-content:space-between;align-items:center;gap:12px;touch-action:none}\n.dpad{display:grid;grid-template-columns:repeat(3,48px);grid-template-rows:repeat(3,48px);gap:6px;flex-shrink:0}\n.dpad.h{grid-template-rows:48px}\n.dpad.v{grid-template-columns:48px}\n.k{border:1px solid rgba(255,255,255,.17);background:rgba(255,255,255,.085);color:#fff;border-radius:50%;font:800 18px system-ui;display:flex;align-items:center;justify-content:center;touch-action:none;padding:0;line-height:1;transition:transform .05s,background .05s}\n.k.on{background:rgba(255,255,255,.3);transform:scale(.93)}\n.k.sp{visibility:hidden}\n.acts{display:flex;gap:9px;align-items:center;flex-wrap:wrap;justify-content:flex-end}\n.k.rd{width:66px;height:66px;border-radius:50%;font-size:15px;flex-direction:column;gap:1px}\n.k.rd small{font-size:7px;letter-spacing:.6px;opacity:.75;font-weight:700}\n.k.a{background:#d8394f;border-color:#ff7f92}\n.k.b{background:#2f6fe4;border-color:#79a5ff}\n.k.c{background:#1f9d63;border-color:#67d9a0}\n.k.d{background:#8a52d6;border-color:#b892f0}\n.pills{display:flex;gap:8px;justify-content:center;margin-top:10px;flex-wrap:wrap}\n.k.pill{padding:10px 18px;border-radius:20px;font:800 11px system-ui;letter-spacing:1.2px;min-width:78px}\n.hint{text-align:center;margin-top:9px;font-size:11px;color:rgba(255,255,255,.48);line-height:1.45}\n.grid{display:grid;gap:5px;touch-action:none}\n.cell{border:1px solid rgba(255,255,255,.12);background:rgba(255,255,255,.05);border-radius:8px;display:flex;align-items:center;justify-content:center;font-weight:800;touch-action:none}\ncanvas{margin:0 auto}\n/* MODO COMPACTO — altura curta.\n   Na bolha da conversa a pagina cresce a vontade e nada disto vale. Ja na\n   bottom sheet das abas a altura e fixa: medido em 500x393, o documento dava\n   663px e 270px ficavam abaixo da dobra, com o deck inteiro fora da tela.\n   Encolher so o canvas nao resolve — a mobilia fixa (head 51 + deck 142 +\n   pills 35 + hint 16 + 92 de padding = 336) come 85% de uma viewport de 393,\n   e sobrariam 71px de tela de jogo. Entao a mobilia encolhe junto.\n   O `hint` some porque ja esta escrito no overlay de inicio, palavra por\n   palavra: e a unica peca aqui que e pura repeticao. */\n@media (max-height:640px){\n /* FAIXA RESERVADA EMBAIXO.\n    O `innerHeight` do webview da bottom sheet conta pixels que a folha nao\n    mostra: a pagina e disposta POR BAIXO da barra de navegacao do Android (48dp\n    no modo de 3 botoes) e da propria borda da folha. Medido no relato: ~60px de\n    excesso, e o que caia fora era a ultima fileira do dpad.\n    Nao ha API que revele isso de dentro — `innerHeight`, `clientHeight` e\n    `visualViewport.height` devolvem todos a altura disposta, nao a visivel.\n    Entao e reserva, nao medida. `env()` cobre quem informa o inset de verdade;\n    o piso de 12px cobre quem nao informa. A reserva encolheu de 72 para 12\n    quando o teto fixo entrou: quem garante que o cartao termina dentro do que a\n    folha mostra passou a ser o teto, e nao uma faixa vazia no rodape.\n    A reserva so e barata porque os controles flutuam: sem isso, 72px sairiam da\n    tela do jogo, que ja estava no limite. */\n .wrap{padding:4px;padding-bottom:calc(8px + env(safe-area-inset-bottom,0px))}\n .main{padding:5px}\n .head{padding:4px 10px}\n .brand{display:none}\n .title{font-size:15px}\n .val{font-size:14px}\n .dpad{grid-template-columns:repeat(3,42px);grid-template-rows:repeat(3,42px);gap:5px}\n .dpad.h{grid-template-rows:42px}\n .dpad.v{grid-template-columns:42px}\n .k{font-size:16px}\n .k.rd{width:58px;height:58px;font-size:14px}\n .deck{margin-top:7px;gap:8px}\n .acts{gap:7px}\n /* As pills sobem para a fileira de acoes: START/REINICIAR precisam continuar\n    ao alcance, e uma fileira propria custa 45px que nao existem aqui. */\n .pills{margin:0;gap:7px}\n .k.pill{padding:7px 13px;min-width:0;font-size:10px}\n .hint{display:none}\n /* CONTROLES SOBRE A TELA.\n    Encolher a mobilia nao bastou: o `encaixar` acredita no `innerHeight`, e no\n    webview da bottom sheet ele e MAIOR que a area visivel — sobra uma faixa\n    escondida atras da borda da folha, e a ultima fileira do dpad caia nela.\n    Chutar uma margem de seguranca seria adivinhar um numero que muda por\n    aparelho. Flutuar os controles tira a disputa: o orcamento vertical vira so\n    cabecalho + tela, e os 110px do dpad mais 27 das pills deixam de contar.\n    `pointer-events` e obrigatorio aqui: o vao entre os botoes precisa deixar o\n    toque passar, senao a faixa inteira viraria parede na frente do canvas e os\n    33 jogos que leem toque na tela parariam de responder embaixo dela. */\n .main{position:relative}\n /* Piso de altura, e ele mora no PALCO, nao no `.main`.\n    Serve para o dpad (110px) nunca transbordar por cima do titulo quando o\n    jogo encolhe — foi o que o cliente viu na segunda tentativa. 170 sai do\n    requisito: o deck fica a 44px do fundo do `.main` e tem 136 de altura (3\n    teclas de 42 mais os vaos), entao o palco precisa de 180 menos os 10 de\n    padding. Numero maior sobra area vazia e, no\n    2048, empurrava 40px pra fora.\n    Por que no palco: o `encaixar` calcula a mobilia como `documento - palco`, e\n    isso so e constante se a folga do piso estiver DENTRO do palco. Com o piso\n    no `.main`, o vazio ficava fora da conta, a \"mobilia\" crescia conforme o\n    jogo encolhia, e a conta realimentava ate o canvas sumir. */\n .stage{min-height:170px}\n .deck{position:absolute;left:10px;right:10px;bottom:10px;margin:0;pointer-events:none;z-index:2}\n .pills{position:absolute;left:0;right:0;bottom:16px;justify-content:center;pointer-events:none;z-index:2}\n .k{pointer-events:auto}\n /* Botao chapado escondendo o jogo e o custo da sobreposicao; a transparencia\n    devolve o que esta embaixo sem tirar a leitura do simbolo. */\n .k{background:rgba(255,255,255,.14);border-color:rgba(255,255,255,.3);backdrop-filter:blur(3px);-webkit-backdrop-filter:blur(3px)}\n .k.on{background:rgba(255,255,255,.42)}\n .k.a{background:rgba(216,57,79,.72)}\n .k.b{background:rgba(47,111,228,.72)}\n .k.c{background:rgba(31,157,99,.72)}\n .k.d{background:rgba(138,82,214,.72)}\n .k.pill{background:rgba(20,25,29,.72)}\n /* A faixa das pills fica logo acima do deck, nao em cima dele. */\n .deck{bottom:44px}\n .msg b{font-size:16px}\n .msg span{font-size:11px;line-height:1.35}\n .msg{padding:10px;gap:4px}\n}</style><body><script>var HZ=(function(){\nvar api={},C={},cv,cx,msg,hudEl,palco,envolucro,parts=[],shakeN=0,vinh=null,held={},tap={},press={},W=0,H=0,tickFn=null,raf=0,prev=0,ac=null,paused=1;\nfunction el(t,c,h){var e=document.createElement(t);if(c)e.className=c;if(h!=null)e.innerHTML=h;return e}\nfunction key(id,cls,label,sub){\n  var b=el('button','k '+cls,label+(sub?'<small>'+sub+'</small>':''));\n  b.setAttribute('type','button');\n  // Deixa o id do botao legivel de fora: a auditoria cruza isto com os\n  // `HZ.on`/`HZ.held` do jogo para achar entrada que nunca dispara.\n  b.dataset.hz=id;\n  // Trava de rolagem: sem preventDefault no pointerdown o webview do WhatsApp\n  // interpreta o arrasto no botao como scroll do chat e o jogo fica injogavel.\n  b.addEventListener('pointerdown',function(e){e.preventDefault();e.stopPropagation();hold(id,1);b.classList.add('on')});\n  var up=function(e){if(e)e.preventDefault();hold(id,0);b.classList.remove('on')};\n  b.addEventListener('pointerup',up);b.addEventListener('pointercancel',up);b.addEventListener('pointerleave',up);\n  b.addEventListener('contextmenu',function(e){e.preventDefault()});\n  return b;\n}\nfunction hold(id,v){\n  if(v){if(!held[id]){tap[id]=1;if(press[id])press[id]()}held[id]=1}else held[id]=0;\n}\nvar ARROW={U:'&#9650;',D:'&#9660;',L:'&#9664;',R:'&#9654;'};\nfunction pad(kind){\n  var d=el('div','dpad'+(kind=='h'?' h':kind=='v'?' v':''));\n  var slots=kind=='h'?['L','R']:kind=='v'?['U','D']:['sp','U','sp','L','sp','R','sp','D','sp'];\n  slots.forEach(function(s){ d.appendChild(s=='sp'?el('button','k sp',''):key(s,'',ARROW[s])); });\n  return d;\n}\nfunction boot(cfg){\n  C=cfg;\n  var wrap=el('div','wrap'),card=el('div','card');\n  var head=el('div','head');\n  head.appendChild(el('div','','<div class=\"brand\">ESDEATH ARCADE</div><div class=\"title\">'+cfg.titulo+'</div>'));\n  hudEl=el('div','hud');\n  (cfg.hud||[]).forEach(function(l){hudEl.appendChild(el('div','','<div class=\"lab\">'+l+'</div><div class=\"val\" id=\"hv'+l+'\">0</div>'))});\n  head.appendChild(hudEl);card.appendChild(head);\n  var main=el('div','main'),stage=el('div','stage');\n  if(cfg.dom){var bd=el('div','',' ');bd.id='board';stage.appendChild(bd)}\n  else{cv=el('canvas');cv.id='cv';cv.width=W=cfg.w||360;cv.height=H=cfg.h||300;stage.appendChild(cv);cx=cv.getContext('2d')}\n  msg=el('div','msg');stage.appendChild(msg);main.appendChild(stage);palco=stage;\n  // `toque`: a TELA e o controle. Existe para o jogo que precisa de UMA acao so\n  // (o dino pula e nada mais). Ali o botao flutuante e puro estorvo — fica\n  // exatamente sobre a pista, que e uma faixa baixa e larga — e o toque na tela\n  // e o gesto que o jogador tenta primeiro de qualquer jeito.\n  if(cfg.toque){\n    var tqd=function(e){\n      if(paused)return;                                   // overlay na frente\n      if(e.target&&e.target.closest&&e.target.closest('.k'))return;   // botao\n      e.preventDefault();hold(cfg.toque,1)};\n    var tqu=function(e){if(e)e.preventDefault();hold(cfg.toque,0)};\n    stage.addEventListener('pointerdown',tqd);\n    stage.addEventListener('pointerup',tqu);\n    stage.addEventListener('pointercancel',tqu);\n    stage.addEventListener('pointerleave',tqu);\n  }\n  if(cfg.pad||cfg.acts){\n    var deck=el('div','deck');\n    deck.appendChild(cfg.pad?pad(cfg.pad):el('div','',''));\n    var acts=el('div','acts');\n    (cfg.acts||[]).forEach(function(a,i){acts.appendChild(key(a[0],'rd '+'abcd'[i],a[1],a[2]))});\n    deck.appendChild(acts);main.appendChild(deck);\n  }\n  if(cfg.pills){var p=el('div','pills');cfg.pills.forEach(function(a){p.appendChild(key(a[0],'pill',a[1]))});main.appendChild(p)}\n  if(cfg.hint)main.appendChild(el('div','hint',cfg.hint));\n  card.appendChild(main);wrap.appendChild(card);document.body.appendChild(wrap);envolucro=wrap;\n  // Segunda camada da trava: navegadores antigos ignoram touch-action.\n  stage.addEventListener('touchmove',function(e){e.preventDefault()},{passive:false});\n  document.querySelectorAll('.deck,.pills').forEach(function(n){\n    n.addEventListener('touchmove',function(e){e.preventDefault()},{passive:false})});\n  if(cfg.keys!==false)document.addEventListener('keydown',function(e){\n    var m={ArrowUp:'U',ArrowDown:'D',ArrowLeft:'L',ArrowRight:'R',KeyW:'U',KeyS:'D',KeyA:'L',KeyD:'R',Space:'A',KeyZ:'A',KeyX:'B',Enter:'START'};\n    if(m[e.code]){e.preventDefault();hold(m[e.code],1)}});\n  if(cfg.keys!==false)document.addEventListener('keyup',function(e){\n    var m={ArrowUp:'U',ArrowDown:'D',ArrowLeft:'L',ArrowRight:'R',KeyW:'U',KeyS:'D',KeyA:'L',KeyD:'R',Space:'A',KeyZ:'A',KeyX:'B',Enter:'START'};\n    if(m[e.code])hold(m[e.code],0)});\n  if(cfg.best)api.best=+(load(cfg.best)||0),api.hud(cfg.hud&&cfg.hud[cfg.hud.length-1]||'BEST',api.best);\n  // A altura do webview MUDA enquanto a folha das abas abre: a pagina nasce\n  // num tamanho e termina noutro. Medir uma vez pega o valor errado, e erra nas\n  // duas direcoes — mediu grande demais e o dpad ficou fora da tela; mediu\n  // pequeno demais e o canvas minguou a ponto dos controles transbordarem.\n  // Dai remedir ate parar de mudar, em vez de confiar num instante.\n  encaixar();\n  [60,250,600,1200].forEach(function(t){setTimeout(encaixar,t)});\n  addEventListener('resize',encaixar);\n  addEventListener('orientationchange',encaixar);\n  if(window.visualViewport)visualViewport.addEventListener('resize',encaixar);\n  // Os eventos acima nao bastam: quando quem muda de tamanho e o CONTAINER que\n  // hospeda a pagina (a folha das abas), o `resize` nem sempre chega — medido,\n  // a folha encolhendo nao disparava nada e o jogo ficava grande demais.\n  // `ResizeObserver` tambem nao serve aqui: ele observaria o documento, que a\n  // viewport ja limita. Entao vigia a altura direto. So chama o encaixe quando\n  // ela muda de fato, entao o custo em regime e uma leitura a cada 250ms.\n  var vhVista=0;\n  setInterval(function(){\n    var v=(window.visualViewport&&window.visualViewport.height)||window.innerHeight||0;\n    if(v&&v!==vhVista){vhVista=v;encaixar()}\n  },250);\n  return api;\n}\n// Encaixe vertical do jogo no que sobra da tela.\n//\n// Existe porque a MESMA pagina roda em dois lugares de altura diferente: na\n// bolha da conversa ela cresce a vontade, e na bottom sheet das abas a altura e\n// fixa — ali o deck caia inteiro abaixo da dobra e o jogo ficava so tela.\n//\n// O tamanho vai em PIXEL EXPLICITO, nao em `object-fit:contain`. O contain\n// encaixaria igual, mas letterboxa DENTRO do elemento: o retangulo medido\n// deixaria de ser a area desenhada, e `HZ.touch` — que converte toque em\n// coordenada do canvas por `getBoundingClientRect` — passaria a errar a mira\n// nos 33 jogos que dependem dele.\n//\n// CALCULA SEM MUTAR, e so escreve quando o resultado muda. Duas razoes:\n// o `ResizeObserver` abaixo observa o documento, e mexer no tamanho de dentro\n// do callback seria laco; e a versao anterior zerava o estilo pra medir o\n// natural, o que fazia o documento pular a cada chamada.\n// Altura maxima do jogo em tela curta. Ver a nota em `encaixar`.\nvar TETO_CURTO=288;\nvar ultimoEncaixe=null;\nfunction encaixar(){\n  if(!palco)return;\n  var bd=cv?null:document.getElementById('board');\n  if(!cv&&!bd)return;\n  var vh=(window.visualViewport&&window.visualViewport.height)||window.innerHeight||0;\n  if(!vh)return;\n  var alt=palco.getBoundingClientRect().height;\n  // Mobilia (cabecalho, paddings, faixa reservada) = o que o involucro tem\n  // alem do palco. Nao depende do tamanho do jogo, entao sai certa medindo em\n  // qualquer estado — nao precisa resetar.\n  //\n  // Sai do ELEMENTO, nao de `documentElement.scrollHeight`: aquele nunca fica\n  // MENOR que a viewport, entao com o conteudo cabendo ele devolvia a altura da\n  // janela, a \"mobilia\" virava `vh - palco` e a sobra dava sempre o proprio\n  // palco atual. Resultado: uma vez encolhido, o jogo nunca mais crescia — foi\n  // o que deixou o canvas do tamanho do piso numa folha com espaco de sobra.\n  var fixo=envolucro.getBoundingClientRect().height-alt;\n  // Em tela curta o orcamento e um TETO FIXO, nao a viewport.\n  //\n  // Porque: na folha das abas o webview tem a altura do NOSSO conteudo. Entao\n  // `innerHeight` nao e restricao externa nenhuma — e a nossa propria saida\n  // realimentada na entrada. Encolher o jogo encolhia o webview, que mandava\n  // encolher de novo, ate o piso; e no comeco, com o layout natural de 663px, o\n  // webview ficava com 663 e quem cortava era a folha. Medido: sobra ~180px de\n  // fundo da folha abaixo do cartao, bem mais que os 72 de reserva.\n  //\n  // O que a folha realmente mostra nao e observavel de dentro. Entao em vez de\n  // medir, manda-se: 288px de jogo cabem nos ~360 que ela exibe, com o\n  // cabecalho e as bordas. O numero saiu de apertar a mobilia primeiro — cada\n  // pixel tirado de padding foi devolvido ao jogo, que e o que se olha. Fora do modo compacto o orcamento volta a ser a\n  // viewport, que ali (arcade, bolha) e restricao de verdade.\n  var sobra=(window.matchMedia&&matchMedia('(max-height:640px)').matches)\n    ?TETO_CURTO:vh-fixo;\n  if(sobra<60)return;                     // viewport sem sentido\n  var larg=palco.clientWidth;\n  if(!larg)return;\n  // Altura que o jogo teria solto. No canvas sai da proporcao (ele e\n  // `width:100%`); no DOM, `offsetHeight` e a altura de layout, que o\n  // `transform` nao altera — por isso serve de referencia estavel.\n  var nat=cv?larg*H/W:bd.offsetHeight;\n  if(!nat)return;\n  var alvo=nat<=sobra?'':(cv\n    ?(function(){var e=Math.min(sobra/H,larg/W);\n       return (W*e).toFixed(1)+'|'+(H*e).toFixed(1)})()\n    :(sobra/nat).toFixed(3));\n  if(alvo===ultimoEncaixe)return;         // nada mudou: nao escreve, nao acorda o observer\n  ultimoEncaixe=alvo;\n  if(cv){\n    if(!alvo){cv.style.width='';cv.style.height='';return}\n    var d=alvo.split('|');\n    cv.style.width=d[0]+'px';cv.style.height=d[1]+'px';\n    return;\n  }\n  // Jogo DOM (os externos: 2048, pacman, dino, bomberman). Aqui nao ha canvas\n  // do motor pra redimensionar — o miolo e markup de terceiro, com layout\n  // proprio. `scale` encolhe o desenhado sem tocar nesse layout, e a altura do\n  // palco e fixada porque `transform` nao muda a caixa reservada: sem isso o\n  // documento continuaria alto e o corte permaneceria.\n  // Nenhum externo usa `HZ.touch` (conferido), entao a caixa transformada nao\n  // desalinha mira nenhuma.\n  if(!alvo){bd.style.transform='';palco.style.height='';return}\n  bd.style.transformOrigin='top center';\n  bd.style.transform='scale('+alvo+')';\n  palco.style.height=(nat*(+alvo)).toFixed(1)+'px';\n  palco.style.overflow='hidden';\n}\nfunction load(k){try{return localStorage.getItem('hz_'+k)}catch(e){return null}}\nfunction save(k,v){try{localStorage.setItem('hz_'+k,v)}catch(e){}}\napi.boot=boot;\napi.hud=function(l,v){var e=document.getElementById('hv'+l);if(e)e.textContent=v};\napi.best=0;\napi.record=function(v){if(v>api.best){api.best=v;if(C.best)save(C.best,v);\n api.hud(C.hud&&C.hud[C.hud.length-1]||'BEST',v);\n if(cx)api.part(W-40,14,'#ffd479',8,2.2);\n return 1}return 0};\napi.held=function(k){return !!held[k]};\napi.tap=function(k){var v=tap[k];tap[k]=0;return !!v};\napi.on=function(k,f){press[k]=f};\n// O 4o argumento e o que o BOTAO faz. Sem ele o botao chamava sempre\n// `C.start`, que em todo jogo com fase e \"recomecar do zero\" — entao um\n// \"PROXIMA FASE\" jogava fora o avanco e o jogador ficava presos na fase 1 para\n// sempre. Medido no shim: sokoban 3 -> 0, bolha 3 -> 1 ao tocar o botao.\napi.over=function(t,s,btn,fn){paused=1;api.shake(9);msg.className='msg';msg.innerHTML='<b>'+t+'</b>'+(s?'<span>'+s+'</span>':'');\n  if(btn!==false){var b=el('button','k pill',btn||'JOGAR');b.style.marginTop='10px';\n    b.addEventListener('pointerdown',function(e){e.preventDefault();var g=fn||C.start;if(g)g()});msg.appendChild(b)}};\napi.play=function(){msg.className='msg off';paused=0};\napi.paused=function(){return paused};\napi.loop=function(f){tickFn=f;if(!raf){prev=0;raf=requestAnimationFrame(step)}};\n// Tremida vai no `transform` do CANVAS, nao no contexto: transladar o contexto\n// deixaria uma faixa vazia na borda em todo jogo que pinta o fundo com\n// `fillRect(0,0,W,H)` em vez do `HZ.clear`.\napi.shake=function(n){shakeN=Math.max(shakeN,n||7)};\napi.part=function(x,y,c,n,v){\n for(var i=0;i<(n||10);i++){var a=Math.random()*6.2832,s=(v||2.4)*(.35+Math.random());\n  parts.push({x:x,y:y,vx:Math.cos(a)*s,vy:Math.sin(a)*s-.6,c:c||'#fff',t:1,r:1.4+Math.random()*2.2})}};\nfunction step(t){raf=requestAnimationFrame(step);\n var ms=prev?Math.min(50,t-prev):16;prev=t;var d=ms/16.667;\n if(tickFn)tickFn(d,t);\n if(cx){if(!vinh){vinh=cx.createRadialGradient(W/2,H*.45,Math.min(W,H)*.3,W/2,H*.5,Math.max(W,H)*.75);\n   vinh.addColorStop(0,'rgba(0,0,0,0)');vinh.addColorStop(.65,'rgba(0,0,0,.1)');\n   vinh.addColorStop(1,'rgba(0,0,0,.34)')}\n  cx.fillStyle=vinh;cx.fillRect(0,0,W,H)}\n if(cx&&parts.length)parts=parts.filter(function(p){\n  p.x+=p.vx*d;p.y+=p.vy*d;p.vy+=.14*d;p.t-=.028*d;\n  if(p.t<=0)return 0;\n  cx.globalAlpha=Math.min(1,p.t);cx.fillStyle=p.c;\n  cx.fillRect(p.x-p.r,p.y-p.r,p.r*2,p.r*2);cx.globalAlpha=1;return 1});\n if(shakeN>.4){shakeN*=.86;\n  if(cv)cv.style.transform='translate('+((Math.random()-.5)*shakeN).toFixed(1)+'px,'\n   +((Math.random()-.5)*shakeN).toFixed(1)+'px)'}\n else if(shakeN){shakeN=0;if(cv)cv.style.transform=''}}\napi.beep=function(f,d,type){\n  try{if(!ac)ac=new (window.AudioContext||window.webkitAudioContext)();\n  var o=ac.createOscillator(),g=ac.createGain();o.type=type||'square';o.frequency.value=f;\n  g.gain.value=.05;o.connect(g);g.connect(ac.destination);o.start();\n  g.gain.exponentialRampToValueAtTime(.001,ac.currentTime+(d||.08));o.stop(ac.currentTime+(d||.08))}catch(e){}};\nObject.defineProperty(api,'cx',{get:function(){return cx}});\nObject.defineProperty(api,'cv',{get:function(){return cv}});\nObject.defineProperty(api,'W',{get:function(){return W}});\nObject.defineProperty(api,'H',{get:function(){return H}});\n// Escurece uma cor #rrggbb por um fator. Serve para derivar o pé do gradiente\n// do fundo a partir da única cor que o jogo informa.\nfunction escuro(c,f){\n if(!/^#[0-9a-fA-F]{6}$/.test(c))return c;\n var n=parseInt(c.slice(1),16);\n return '#'+[16,8,0].map(function(s){\n  return ('0'+Math.round(((n>>s)&255)*(1-f)).toString(16)).slice(-2)}).join('')}\n// `clear` deixou de ser cor chapada: o fundo desce para uma versão mais escura\n// de si mesmo. Um jogo que só passa uma cor ganha profundidade sem saber.\napi.clear=function(c){c=c||'#080b0d';\n var g=cx.createLinearGradient(0,0,0,H);\n g.addColorStop(0,c);g.addColorStop(1,escuro(c,.42));\n cx.fillStyle=g;cx.fillRect(0,0,W,H)};\n// Chanfro de 1px em cima e embaixo: é como pixel art sombreia, e cai bem tanto\n// em tijolo e plataforma quanto em barra de HUD.\napi.box=function(x,y,w,h,c){cx.fillStyle=c;cx.fillRect(x,y,w,h);\n if(w>3&&h>3){cx.fillStyle='rgba(255,255,255,.14)';cx.fillRect(x,y,w,1);\n  cx.fillStyle='rgba(0,0,0,.2)';cx.fillRect(x,y+h-1,w,1)}};\n// Pixel art a partir de um mapa de texto: cada caractere é um pixel, '.' é\n// vazio. É assim que os originais são desenhados, e cabe em poucas linhas —\n// desenhar o invasor com retângulo solto é o que faz parecer imitação.\napi.sprite=function(x,y,s,mapa,cores){\n for(var r=0;r<mapa.length;r++){var lin=mapa[r];\n  for(var c=0;c<lin.length;c++){var k=lin.charAt(c);\n   if(k==='.'||k===' ')continue;\n   cx.fillStyle=cores[k]||cores['X']||'#fff';\n   cx.fillRect(x+c*s,y+r*s,s,s)}}};\n// Vidas: 11 jogos escreviam ❤️, que e emoji com seletor de variacao — em parte\n// dos aparelhos sai como glifo de TEXTO (preto e chapado) e em outros nem sai.\n// Quantas vidas restam nao pode depender da fonte do celular.\nvar CORACAO=[\".XX.XX.\",\"XXXXXXX\",\"XXXXXXX\",\"XXXXXXX\",\".XXXXX.\",\"..XXX..\",\"...X...\"];\napi.vidas=function(n,x,y,c,s){s=s||2;\n for(var i=0;i<n;i++)api.sprite(x+i*(7*s+3),y,s,CORACAO,{X:c||'#ff4757'})};\napi.txt=function(s,x,y,c,sz,al){cx.fillStyle=c||'#fff';cx.font='800 '+(sz||14)+'px system-ui';cx.textAlign=al||'center';cx.fillText(s,x,y);cx.textAlign='left'};\n// Brilho no alto à esquerda transforma o disco chapado em esfera. Vale para\n// bola, inimigo, moeda — tudo que os jogos desenham com `circ`.\napi.circ=function(x,y,r,c){cx.fillStyle=c;cx.beginPath();cx.arc(x,y,r,0,6.284);cx.fill();\n if(r>3.5){var g=cx.createRadialGradient(x-r*.34,y-r*.34,r*.08,x,y,r);\n  g.addColorStop(0,'rgba(255,255,255,.3)');g.addColorStop(.55,'rgba(255,255,255,.06)');\n  g.addColorStop(1,'rgba(0,0,0,.16)');\n  cx.fillStyle=g;cx.beginPath();cx.arc(x,y,r,0,6.284);cx.fill()}};\n// Toque direto na tela do jogo (mira, seleção): devolve coordenadas do canvas.\napi.touch=function(f){var t=C.dom?document.getElementById('board'):cv;\n  t.addEventListener('pointerdown',function(e){e.preventDefault();\n    var r=t.getBoundingClientRect();f((e.clientX-r.left)/r.width*W,(e.clientY-r.top)/r.height*H,e)})};\napi.load=load;api.save=save;\napi.rnd=function(n){return Math.random()*n};\napi.ri=function(n){return Math.floor(Math.random()*n)};\nreturn api;})();\nvar N=5,CS=54,OX,OY=76,g,cur,dinheiro,dia,sel,msg,mt,agua,fim,estacao;\n// Os quatro cultivos eram emoji — a lavoura inteira dependia da fonte do\n// aparelho. Agora cada um e um mapa 8x8 que cresce com a maturacao.\nvar SEM=[[\"...GG...\",\"..GYYG..\",\".GYYYYG.\",\".GYYYYG.\",\".GYYYYG.\",\"..GYYG..\",\"...GG...\",\"........\"],\n         [\".G.GG.G.\",\"..GGGG..\",\"..XXXX..\",\"..XXXX..\",\"...XX...\",\"...XX...\",\"....X...\",\"........\"],\n         [\"...G....\",\"..GGG...\",\".XXXXXX.\",\"XXXXXXXX\",\"XXXXXXXX\",\".XXXXXX.\",\"..XXXX..\",\"........\"],\n         [\".GGGGGG.\",\"..GGGG..\",\".XXXXXX.\",\"XXWXXWXX\",\".XXXXXX.\",\"..XWXX..\",\"...XX...\",\"........\"]];\nvar CSEM=[{Y:\"#f1c40f\",G:\"#2ecc71\"},{X:\"#e67e22\",G:\"#2ecc71\"},\n          {X:\"#e74c3c\",G:\"#2ecc71\"},{X:\"#e0245e\",W:\"#ffe0bd\",G:\"#2ecc71\"}];\n// Paleta de estacao: nascia declarada dentro do laco e nunca era lida, entao\n// as 4 estacoes tinham exatamente a mesma cara.\nvar CE=[\"#5d8a3a\",\"#7a9a3a\",\"#8a7a3a\",\"#6a8a5a\"];\nvar CULT=[[\"Milho\",8,120,26],[\"Cenoura\",5,80,18],[\"Tomate\",14,190,34],[\"Morango\",22,310,46]];\nHZ.boot({titulo:\"🌾 Fazendinha\",w:340,h:400,best:\"fazendinha\",hud:[\"MOEDAS\",\"RECORDE\"],pad:\"4\",\n acts:[[\"A\",\"🌱\",\"PLANTAR/COLHER\"],[\"B\",\"🔀\",\"SEMENTE\"]],pills:[[\"START\",\"REINICIAR\"],[\"C\",\"💧 REGAR\"]],\n hint:\"Setas movem o cursor · A planta e colhe · regar (💧) acelera o crescimento\",start:novo});\nfunction novo(){OX=(340-N*CS)/2;\n g=[];for(var i=0;i<N*N;i++)g.push({c:-1,t:0,reg:0});\n cur=12;dinheiro=60;dia=1;sel=0;msg=\"\";mt=0;agua=10;fim=0;estacao=0;\n HZ.hud(\"MOEDAS\",60);HZ.play()}\nHZ.on(\"START\",novo);\nHZ.on(\"B\",function(){sel=(sel+1)%CULT.length;HZ.beep(600,.05)});\nHZ.on(\"U\",function(){cur=(cur+N*N-N)%(N*N);HZ.beep(400,.03)});\nHZ.on(\"D\",function(){cur=(cur+N)%(N*N);HZ.beep(400,.03)});\nHZ.on(\"L\",function(){cur=(cur+N*N-1)%(N*N);HZ.beep(400,.03)});\nHZ.on(\"R\",function(){cur=(cur+1)%(N*N);HZ.beep(400,.03)});\nHZ.on(\"C\",function(){if(HZ.paused()||fim)return;\n var c=g[cur];\n if(c.c<0||!agua){fala(agua?\"Nada plantado aqui.\":\"Sem água — ela volta a cada dia.\");return}\n agua--;c.reg=1;fala(\"Regado! cresce mais rápido\");HZ.beep(1000,.09)});\nHZ.on(\"A\",function(){if(HZ.paused()||fim)return;\n var c=g[cur],k=CULT[sel];\n if(c.c<0){\n  if(dinheiro<k[1]){fala(\"Faltam moedas para \"+k[0]);return}\n  dinheiro-=k[1];c.c=sel;c.t=0;c.reg=0;HZ.hud(\"MOEDAS\",dinheiro);\n  fala(\"Plantou \"+k[0]);HZ.beep(700,.07);return}\n var kc=CULT[c.c];\n if(c.t>=kc[3]){\n  var v=kc[2]+(c.reg?Math.floor(kc[2]*.25):0);\n  dinheiro+=v;HZ.hud(\"MOEDAS\",dinheiro);HZ.record(dinheiro);\n  fala(\"Colheu \"+kc[0]+\" +\"+v);HZ.beep(1400,.15);c.c=-1;c.t=0;c.reg=0}\n else fala(kc[0]+\" ainda leva \"+Math.ceil(kc[3]-c.t)+\" dias\")});\nfunction fala(s){msg=s;mt=130}\nHZ.loop(function(dt){var W=HZ.W,H=HZ.H;\n HZ.clear(\"#2c1e12\");\n if(!HZ.paused()&&!fim){\n  if(mt>0)mt-=dt;else msg=\"\";\n  tempo=(tempo||0)+dt;\n  if(tempo>110){tempo=0;dia++;agua=Math.min(10,agua+3);\n   estacao=Math.floor((dia-1)/10)%4;\n   g.forEach(function(c){if(c.c>=0)c.t+=c.reg?1.7:1});\n   if(dia>40){fim=1;HZ.record(dinheiro);\n    HZ.over(\"FIM DA TEMPORADA\",\"40 dias · \"+dinheiro+\" moedas\")}}}\n HZ.box(0,0,W,64,\"#3d2a18\");\n HZ.txt(\"DIA \"+dia+\" de 40   ·   \"+[\"primavera\",\"verão\",\"outono\",\"inverno\"][estacao],\n  W/2,24,\"#ffd479\",13);\n HZ.txt(agua+\" regas   ·   \"+dinheiro+\" moedas\",W/2,46,\"rgba(255,255,255,.65)\",12);\n for(var r=0;r<N;r++)for(var c=0;c<N;c++){\n  var i=r*N+c,q=g[i],x=OX+c*CS,y=OY+r*CS;\n  HZ.box(x+2,y+2,CS-4,CS-4,q.reg?\"#5c4028\":\"#6b4a2e\");\n  HZ.box(x+5,y+CS-12,CS-10,3,CE[estacao]);\n  if(q.c>=0){var pr=Math.min(1,q.t/CULT[q.c][3]),sc=1+Math.round(pr*2);\n   HZ.sprite(x+CS/2-4*sc,y+CS/2-4*sc+3,sc,SEM[q.c],CSEM[q.c]);\n   HZ.box(x+6,y+CS-9,(CS-12)*pr,4,pr>=1?\"#2ed573\":\"#ffd479\")}\n  if(i==cur){HZ.cx.strokeStyle=\"#7ee8fa\";HZ.cx.lineWidth=3;HZ.cx.strokeRect(x+2,y+2,CS-4,CS-4)}}\n var y0=OY+N*CS+14;\n HZ.txt(\"SEMENTE SELECIONADA (B troca)\",W/2,y0,\"rgba(255,255,255,.45)\",9);\n CULT.forEach(function(k,i){\n  var x=14+i*80;\n  HZ.box(x,y0+8,74,44,i==sel?\"#2d5f7a\":\"rgba(255,255,255,.05)\");\n  HZ.sprite(x+29,y0+14,2,SEM[i],CSEM[i]);\n  HZ.txt(k[1]+\"→\"+k[2],x+37,y0+45,dinheiro>=k[1]?\"#2ed573\":\"#ff6b81\",10)});\n HZ.txt(msg,W/2,y0+72,\"#ffd479\",12);\n});\nvar tempo=0;\nnovo();HZ.over(\"FAZENDINHA\",\"40 dias para lucrar. Morango custa caro e demora, cenoura gira rápido.\\nRegar acelera o crescimento e ainda dá 25% a mais na colheita.\");\n</script></body>"}