{"titulo": "🐸 Travessia", "html": "<style>*{-webkit-tap-highlight-color:transparent;-webkit-user-select:none;user-select:none;-webkit-touch-callout:none;box-sizing:border-box;margin:0}\nhtml,body{overscroll-behavior:none;-webkit-overflow-scrolling:auto}\n/* Escuro sempre: transparente, a pagina herdava o fundo de quem hospeda, e no\n   tema claro do WhatsApp (e no arcade) o que sobrava em volta do cartao era\n   branco. */\nhtml{color-scheme:dark;background:#0d1114}\nbody{background:#0d1114;font-family:-apple-system,'Segoe UI',Roboto,Arial,sans-serif;color:#e8edf0}\n.wrap{width:100%;max-width:620px;margin:auto;padding:12px}\n.card{background:rgba(20,25,29,.985);border:1px solid rgba(255,255,255,.13);border-radius:16px;overflow:hidden;box-shadow:0 8px 34px rgba(0,0,0,.45)}\n.head{padding:10px 14px;border-bottom:1px solid rgba(255,255,255,.09);display:flex;justify-content:space-between;align-items:center;gap:10px}\n.brand{font-size:9px;letter-spacing:1.7px;color:rgba(255,255,255,.34)}\n.title{font-size:17px;font-weight:900;color:#fff;line-height:1.2}\n.hud{display:flex;gap:13px;text-align:right;flex-shrink:0}\n.lab{font-size:8px;letter-spacing:1px;color:rgba(255,255,255,.42)}\n.val{font:800 16px ui-monospace,'Courier New',monospace;color:#ffd479;white-space:nowrap}\n.main{padding:12px}\n.stage{position:relative;touch-action:none;-ms-touch-action:none}\ncanvas{display:block;width:100%;height:auto;background:#080b0d;border:1px solid rgba(255,255,255,.1);border-radius:12px;touch-action:none}\n#board{touch-action:none}\n.msg{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6px;background:rgba(5,8,10,.86);border-radius:12px;text-align:center;padding:16px}\n.msg.off{display:none}\n.msg b{font-size:19px;color:#fff;letter-spacing:.5px}\n.msg span{font-size:12px;color:rgba(255,255,255,.62);line-height:1.5;max-width:88%}\n.deck{margin-top:11px;display:flex;justify-content:space-between;align-items:center;gap:12px;touch-action:none}\n.dpad{display:grid;grid-template-columns:repeat(3,48px);grid-template-rows:repeat(3,48px);gap:6px;flex-shrink:0}\n.dpad.h{grid-template-rows:48px}\n.dpad.v{grid-template-columns:48px}\n.k{border:1px solid rgba(255,255,255,.17);background:rgba(255,255,255,.085);color:#fff;border-radius:50%;font:800 18px system-ui;display:flex;align-items:center;justify-content:center;touch-action:none;padding:0;line-height:1;transition:transform .05s,background .05s}\n.k.on{background:rgba(255,255,255,.3);transform:scale(.93)}\n.k.sp{visibility:hidden}\n.acts{display:flex;gap:9px;align-items:center;flex-wrap:wrap;justify-content:flex-end}\n.k.rd{width:66px;height:66px;border-radius:50%;font-size:15px;flex-direction:column;gap:1px}\n.k.rd small{font-size:7px;letter-spacing:.6px;opacity:.75;font-weight:700}\n.k.a{background:#d8394f;border-color:#ff7f92}\n.k.b{background:#2f6fe4;border-color:#79a5ff}\n.k.c{background:#1f9d63;border-color:#67d9a0}\n.k.d{background:#8a52d6;border-color:#b892f0}\n.pills{display:flex;gap:8px;justify-content:center;margin-top:10px;flex-wrap:wrap}\n.k.pill{padding:10px 18px;border-radius:20px;font:800 11px system-ui;letter-spacing:1.2px;min-width:78px}\n.hint{text-align:center;margin-top:9px;font-size:11px;color:rgba(255,255,255,.48);line-height:1.45}\n.grid{display:grid;gap:5px;touch-action:none}\n.cell{border:1px solid rgba(255,255,255,.12);background:rgba(255,255,255,.05);border-radius:8px;display:flex;align-items:center;justify-content:center;font-weight:800;touch-action:none}\ncanvas{margin:0 auto}\n/* MODO COMPACTO — altura curta.\n   Na bolha da conversa a pagina cresce a vontade e nada disto vale. Ja na\n   bottom sheet das abas a altura e fixa: medido em 500x393, o documento dava\n   663px e 270px ficavam abaixo da dobra, com o deck inteiro fora da tela.\n   Encolher so o canvas nao resolve — a mobilia fixa (head 51 + deck 142 +\n   pills 35 + hint 16 + 92 de padding = 336) come 85% de uma viewport de 393,\n   e sobrariam 71px de tela de jogo. Entao a mobilia encolhe junto.\n   O `hint` some porque ja esta escrito no overlay de inicio, palavra por\n   palavra: e a unica peca aqui que e pura repeticao. */\n@media (max-height:640px){\n /* FAIXA RESERVADA EMBAIXO.\n    O `innerHeight` do webview da bottom sheet conta pixels que a folha nao\n    mostra: a pagina e disposta POR BAIXO da barra de navegacao do Android (48dp\n    no modo de 3 botoes) e da propria borda da folha. Medido no relato: ~60px de\n    excesso, e o que caia fora era a ultima fileira do dpad.\n    Nao ha API que revele isso de dentro — `innerHeight`, `clientHeight` e\n    `visualViewport.height` devolvem todos a altura disposta, nao a visivel.\n    Entao e reserva, nao medida. `env()` cobre quem informa o inset de verdade;\n    o piso de 12px cobre quem nao informa. A reserva encolheu de 72 para 12\n    quando o teto fixo entrou: quem garante que o cartao termina dentro do que a\n    folha mostra passou a ser o teto, e nao uma faixa vazia no rodape.\n    A reserva so e barata porque os controles flutuam: sem isso, 72px sairiam da\n    tela do jogo, que ja estava no limite. */\n .wrap{padding:4px;padding-bottom:calc(8px + env(safe-area-inset-bottom,0px))}\n .main{padding:5px}\n .head{padding:4px 10px}\n .brand{display:none}\n .title{font-size:15px}\n .val{font-size:14px}\n .dpad{grid-template-columns:repeat(3,42px);grid-template-rows:repeat(3,42px);gap:5px}\n .dpad.h{grid-template-rows:42px}\n .dpad.v{grid-template-columns:42px}\n .k{font-size:16px}\n .k.rd{width:58px;height:58px;font-size:14px}\n .deck{margin-top:7px;gap:8px}\n .acts{gap:7px}\n /* As pills sobem para a fileira de acoes: START/REINICIAR precisam continuar\n    ao alcance, e uma fileira propria custa 45px que nao existem aqui. */\n .pills{margin:0;gap:7px}\n .k.pill{padding:7px 13px;min-width:0;font-size:10px}\n .hint{display:none}\n /* CONTROLES SOBRE A TELA.\n    Encolher a mobilia nao bastou: o `encaixar` acredita no `innerHeight`, e no\n    webview da bottom sheet ele e MAIOR que a area visivel — sobra uma faixa\n    escondida atras da borda da folha, e a ultima fileira do dpad caia nela.\n    Chutar uma margem de seguranca seria adivinhar um numero que muda por\n    aparelho. Flutuar os controles tira a disputa: o orcamento vertical vira so\n    cabecalho + tela, e os 110px do dpad mais 27 das pills deixam de contar.\n    `pointer-events` e obrigatorio aqui: o vao entre os botoes precisa deixar o\n    toque passar, senao a faixa inteira viraria parede na frente do canvas e os\n    33 jogos que leem toque na tela parariam de responder embaixo dela. */\n .main{position:relative}\n /* Piso de altura, e ele mora no PALCO, nao no `.main`.\n    Serve para o dpad (110px) nunca transbordar por cima do titulo quando o\n    jogo encolhe — foi o que o cliente viu na segunda tentativa. 170 sai do\n    requisito: o deck fica a 44px do fundo do `.main` e tem 136 de altura (3\n    teclas de 42 mais os vaos), entao o palco precisa de 180 menos os 10 de\n    padding. Numero maior sobra area vazia e, no\n    2048, empurrava 40px pra fora.\n    Por que no palco: o `encaixar` calcula a mobilia como `documento - palco`, e\n    isso so e constante se a folga do piso estiver DENTRO do palco. Com o piso\n    no `.main`, o vazio ficava fora da conta, a \"mobilia\" crescia conforme o\n    jogo encolhia, e a conta realimentava ate o canvas sumir. */\n .stage{min-height:170px}\n .deck{position:absolute;left:10px;right:10px;bottom:10px;margin:0;pointer-events:none;z-index:2}\n .pills{position:absolute;left:0;right:0;bottom:16px;justify-content:center;pointer-events:none;z-index:2}\n .k{pointer-events:auto}\n /* Botao chapado escondendo o jogo e o custo da sobreposicao; a transparencia\n    devolve o que esta embaixo sem tirar a leitura do simbolo. */\n .k{background:rgba(255,255,255,.14);border-color:rgba(255,255,255,.3);backdrop-filter:blur(3px);-webkit-backdrop-filter:blur(3px)}\n .k.on{background:rgba(255,255,255,.42)}\n .k.a{background:rgba(216,57,79,.72)}\n .k.b{background:rgba(47,111,228,.72)}\n .k.c{background:rgba(31,157,99,.72)}\n .k.d{background:rgba(138,82,214,.72)}\n .k.pill{background:rgba(20,25,29,.72)}\n /* A faixa das pills fica logo acima do deck, nao em cima dele. */\n .deck{bottom:44px}\n .msg b{font-size:16px}\n .msg span{font-size:11px;line-height:1.35}\n .msg{padding:10px;gap:4px}\n}\n\n/* \"Como jogar\": botao no cabecalho e painel por cima do cartao. No modo\n   console a `hint` some (o espaco vai para o controle), entao sem isto o\n   jogador que abre um jogo novo nao tinha onde ler como se joga. */\n.card{position:relative}\n.ajb{position:relative;z-index:8;flex-shrink:0;width:30px;height:30px;border-radius:50%;border:1px solid rgba(255,255,255,.22);\n background:rgba(255,255,255,.08);color:#fff;font:800 15px system-ui;display:flex;align-items:center;\n justify-content:center;padding:0;touch-action:manipulation}\n.ajb.novo{animation:ajpulso 1.4s ease-in-out 3}\n@keyframes ajpulso{50%{box-shadow:0 0 0 7px rgba(255,212,121,.28);border-color:#ffd479}}\n.ajp{position:absolute;inset:0;z-index:9;background:rgba(10,14,17,.97);display:flex;flex-direction:column;\n padding:16px 16px 12px;gap:10px;overflow:auto;border-radius:16px}\n.ajp.off{display:none}\n.ajp h3{margin:0;font-size:17px;color:#fff}\n.ajp p{margin:0;font-size:13px;line-height:1.5;color:rgba(255,255,255,.78)}\n.ajp ul{list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:7px}\n.ajp li{display:flex;gap:10px;align-items:center;font-size:13px;color:rgba(255,255,255,.85)}\n.ajp li b{min-width:62px;text-align:center;padding:4px 8px;border-radius:9px;background:rgba(255,255,255,.1);\n font:800 12px system-ui;color:#ffd479}\n.ajp .fechar{margin-top:auto;align-self:center;padding:10px 26px;border-radius:20px;border:0;\n background:#ffd479;color:#1b1400;font:800 12px system-ui;letter-spacing:1.2px}\n\n/* MODO CONSOLE — tela cheia com espaco sobrando.\n   Desde que o card abre em tela cheia (folha FOAEmbeddedScreenContentTabbed,\n   2026-09-25) sobra meia tela embaixo do jogo. O `encaixar` liga `html.alto`\n   quando cabe jogo + controle, e ai o deck sai de cima do jogo e vira um\n   controle de verdade embaixo dele. Regras com `html.alto` na frente para\n   vencer o @media compacto, que continua casando: no card o webview tem a\n   altura do CONTEUDO, entao o `max-height:640px` diz pouco sobre a tela. */\nhtml.alto .wrap{display:flex;flex-direction:column;justify-content:center;padding:6px;padding-bottom:calc(10px + env(safe-area-inset-bottom,0px))}\nhtml.alto .main{padding:8px;position:static}\nhtml.alto .stage{min-height:0}\nhtml.alto .hint{display:none}\nhtml.alto .deck{position:relative;left:auto;right:auto;bottom:auto;pointer-events:auto;\n margin-top:10px;padding:16px 18px 14px;border-radius:26px;align-items:center;\n background:linear-gradient(180deg,#232b31 0%,#161c20 100%);\n border:1px solid rgba(255,255,255,.08);\n box-shadow:inset 0 1px 0 rgba(255,255,255,.07),inset 0 -6px 14px rgba(0,0,0,.35),0 6px 18px rgba(0,0,0,.35)}\nhtml.alto .pills{position:static;margin:10px 0 2px;gap:14px;pointer-events:auto}\nhtml.alto .k{backdrop-filter:none;-webkit-backdrop-filter:none}\n/* D-pad em cruz: bracos quadrados colados num miolo, como o de console. */\nhtml.alto .dpad{grid-template-columns:repeat(3,54px);grid-template-rows:repeat(3,54px);gap:0;\n filter:drop-shadow(0 5px 0 #0b0f12) drop-shadow(0 8px 10px rgba(0,0,0,.45))}\nhtml.alto .dpad.h{grid-template-columns:repeat(2,64px);grid-template-rows:64px}\nhtml.alto .dpad.v{grid-template-columns:64px;grid-template-rows:repeat(2,64px)}\nhtml.alto .dpad .k{border-radius:0;border:0;font-size:17px;color:rgba(255,255,255,.78);\n background:linear-gradient(180deg,#3a444c,#2c353c)}\nhtml.alto .dpad .k.on{background:linear-gradient(180deg,#252d33,#1d2429);transform:none;color:#fff}\nhtml.alto .dpad [data-hz=U]{border-radius:12px 12px 0 0}\nhtml.alto .dpad [data-hz=D]{border-radius:0 0 12px 12px}\nhtml.alto .dpad [data-hz=L]{border-radius:12px 0 0 12px}\nhtml.alto .dpad [data-hz=R]{border-radius:0 12px 12px 0}\nhtml.alto .dpad.h [data-hz=L]{border-radius:14px 0 0 14px}\nhtml.alto .dpad.h [data-hz=R]{border-radius:0 14px 14px 0}\nhtml.alto .dpad.v [data-hz=U]{border-radius:14px 14px 0 0}\nhtml.alto .dpad.v [data-hz=D]{border-radius:0 0 14px 14px}\nhtml.alto .dpad .k.sp{visibility:hidden}\nhtml.alto .dpad .k.hub{visibility:visible;pointer-events:none;\n background:radial-gradient(circle at 50% 50%,#242c32 0 38%,#2f383f 40% 100%)}\n/* Botoes de acao: bolha com brilho e degrau que afunda no toque. */\nhtml.alto .acts{gap:14px;flex-wrap:nowrap;flex-direction:row-reverse;align-items:flex-end}\nhtml.alto .k.rd{width:70px;height:70px;border:0;font-size:22px;color:#fff;\n text-shadow:0 1px 0 rgba(0,0,0,.35);transition:transform .06s,box-shadow .06s}\nhtml.alto .k.rd small{font-size:8px;letter-spacing:.8px;opacity:.85}\nhtml.alto .acts .k.rd:first-child:not(:last-child){transform:translateY(-26px)}\nhtml.alto .k.a{background:radial-gradient(circle at 34% 28%,#ff8a9c 0,#e2465d 38%,#b4263c 100%);box-shadow:0 6px 0 #7d1426,0 10px 16px rgba(0,0,0,.45)}\nhtml.alto .k.b{background:radial-gradient(circle at 34% 28%,#8fb4ff 0,#3b78ea 38%,#2350b0 100%);box-shadow:0 6px 0 #173a80,0 10px 16px rgba(0,0,0,.45)}\nhtml.alto .k.c{background:radial-gradient(circle at 34% 28%,#86ecb8 0,#27ad6e 38%,#177a4c 100%);box-shadow:0 6px 0 #0f5535,0 10px 16px rgba(0,0,0,.45)}\nhtml.alto .k.d{background:radial-gradient(circle at 34% 28%,#cfaaf7 0,#9258dd 38%,#6634ab 100%);box-shadow:0 6px 0 #45207a,0 10px 16px rgba(0,0,0,.45)}\nhtml.alto .k.rd.on{box-shadow:0 1px 0 rgba(0,0,0,.6),0 3px 6px rgba(0,0,0,.4);transform:translateY(5px)}\nhtml.alto .acts .k.rd:first-child:not(:last-child).on{transform:translateY(-21px)}\nhtml.alto .k.pill{background:linear-gradient(180deg,#2b3339,#1f262b);border:1px solid rgba(255,255,255,.1);\n color:rgba(255,255,255,.7);padding:8px 16px;font-size:10px;letter-spacing:1.6px;\n box-shadow:0 3px 0 #0b0f12}\nhtml.alto .k.pill.on{transform:translateY(2px);box-shadow:0 1px 0 #0b0f12}</style><body><script>var HZ=(function(){\nvar api={},C={},cv,cx,msg,hudEl,palco,envolucro,parts=[],shakeN=0,vinh=null,held={},tap={},press={},W=0,H=0,tickFn=null,raf=0,prev=0,ac=null,paused=1;\nfunction el(t,c,h){var e=document.createElement(t);if(c)e.className=c;if(h!=null)e.innerHTML=h;return e}\nfunction key(id,cls,label,sub){\n  var b=el('button','k '+cls,label+(sub?'<small>'+sub+'</small>':''));\n  b.setAttribute('type','button');\n  // Deixa o id do botao legivel de fora: a auditoria cruza isto com os\n  // `HZ.on`/`HZ.held` do jogo para achar entrada que nunca dispara.\n  b.dataset.hz=id;\n  // Trava de rolagem: sem preventDefault no pointerdown o webview do WhatsApp\n  // interpreta o arrasto no botao como scroll do chat e o jogo fica injogavel.\n  b.addEventListener('pointerdown',function(e){e.preventDefault();e.stopPropagation();hold(id,1);b.classList.add('on');\n    try{if(navigator.vibrate)navigator.vibrate(9)}catch(x){}});\n  var up=function(e){if(e)e.preventDefault();hold(id,0);b.classList.remove('on')};\n  b.addEventListener('pointerup',up);b.addEventListener('pointercancel',up);b.addEventListener('pointerleave',up);\n  b.addEventListener('contextmenu',function(e){e.preventDefault()});\n  return b;\n}\nfunction hold(id,v){\n  if(v){if(!held[id]){tap[id]=1;if(press[id])press[id]()}held[id]=1}else held[id]=0;\n}\nvar ARROW={U:'&#9650;',D:'&#9660;',L:'&#9664;',R:'&#9654;'};\nfunction pad(kind){\n  var d=el('div','dpad'+(kind=='h'?' h':kind=='v'?' v':''));\n  var slots=kind=='h'?['L','R']:kind=='v'?['U','D']:['sp','U','sp','L','sp','R','sp','D','sp'];\n  slots.forEach(function(s,i){ d.appendChild(s=='sp'?el('button','k sp'+(i==4?' hub':''),''):key(s,'',ARROW[s])); });\n  return d;\n}\n// Legenda dos controles tirada da PROPRIA configuracao do deck: nao tem como\n// descrever um botao que nao existe, nem esquecer um que existe.\nvar ajudaAberta=0;\nfunction montarAjuda(cfg,head,card){\n  var txt=cfg.ajuda||cfg.hint||'';\n  var lin=[];\n  if(cfg.pad)lin.push([cfg.pad=='h'?'&#9664; &#9654;':cfg.pad=='v'?'&#9650; &#9660;':'&#9650;&#9660;&#9664;&#9654;',\n    cfg.padTxt||(cfg.pad=='h'?'mover para os lados':cfg.pad=='v'?'mover para cima e para baixo':'mover')]);\n  (cfg.acts||[]).forEach(function(a){lin.push([a[1],(a[3]||a[2]||'acao').toString().toLowerCase()])});\n  (cfg.pills||[]).forEach(function(a){lin.push([a[1],a[2]||(a[0]=='START'?'come\\u00e7ar / pausar':a[0]=='SELECT'?'trocar a op\\u00e7\\u00e3o do menu':a[1].toLowerCase())])});\n  if(cfg.toque)lin.push(['&#128070;','toque em qualquer lugar da tela']);\n  if(!txt&&!lin.length)return;\n  var b=el('button','ajb novo','?');b.type='button';b.setAttribute('aria-label','Como jogar');\n  var p=el('div','ajp off','<h3>&#10067; Como jogar</h3>'+(txt?'<p>'+txt+'</p>':'')\n    +(lin.length?'<ul>'+lin.map(function(l){return '<li><b>'+l[0]+'</b><span>'+l[1]+'</span></li>'}).join('')+'</ul>':''));\n  var f=el('button','fechar','ENTENDI');f.type='button';p.appendChild(f);\n  var abrir=function(v){ajudaAberta=v;p.classList.toggle('off',!v)};\n  b.addEventListener('click',function(e){e.stopPropagation();b.classList.remove('novo');abrir(1)});\n  f.addEventListener('click',function(e){e.stopPropagation();abrir(0)});\n  p.addEventListener('pointerdown',function(e){e.stopPropagation()});\n  head.appendChild(b);card.appendChild(p);\n}\nfunction boot(cfg){\n  C=cfg;\n  var wrap=el('div','wrap'),card=el('div','card');\n  var head=el('div','head');\n  head.appendChild(el('div','','<div class=\"brand\">ESDEATH ARCADE</div><div class=\"title\">'+cfg.titulo+'</div>'));\n  hudEl=el('div','hud');\n  (cfg.hud||[]).forEach(function(l){hudEl.appendChild(el('div','','<div class=\"lab\">'+l+'</div><div class=\"val\" id=\"hv'+l+'\">0</div>'))});\n  head.appendChild(hudEl);card.appendChild(head);\n  montarAjuda(cfg,head,card);\n  var main=el('div','main'),stage=el('div','stage');\n  if(cfg.dom){var bd=el('div','',' ');bd.id='board';stage.appendChild(bd)}\n  else{cv=el('canvas');cv.id='cv';cv.width=W=cfg.w||360;cv.height=H=cfg.h||300;stage.appendChild(cv);cx=cv.getContext('2d')}\n  msg=el('div','msg');stage.appendChild(msg);main.appendChild(stage);palco=stage;\n  // `toque`: a TELA e o controle. Existe para o jogo que precisa de UMA acao so\n  // (o dino pula e nada mais). Ali o botao flutuante e puro estorvo — fica\n  // exatamente sobre a pista, que e uma faixa baixa e larga — e o toque na tela\n  // e o gesto que o jogador tenta primeiro de qualquer jeito.\n  if(cfg.toque){\n    var tqd=function(e){\n      if(paused)return;                                   // overlay na frente\n      if(e.target&&e.target.closest&&e.target.closest('.k'))return;   // botao\n      e.preventDefault();hold(cfg.toque,1)};\n    var tqu=function(e){if(e)e.preventDefault();hold(cfg.toque,0)};\n    // A tela INTEIRA, nao so o palco: em tela cheia o jogo de toque e uma\n    // tira no meio da folha, e tocar no vazio em volta nao fazia nada.\n    document.addEventListener('pointerdown',tqd);\n    document.addEventListener('pointerup',tqu);\n    document.addEventListener('pointercancel',tqu);\n    document.addEventListener('touchmove',function(e){e.preventDefault()},{passive:false});\n  }\n  if(cfg.pad||cfg.acts){\n    var deck=el('div','deck');\n    deck.appendChild(cfg.pad?pad(cfg.pad):el('div','',''));\n    var acts=el('div','acts');\n    (cfg.acts||[]).forEach(function(a,i){acts.appendChild(key(a[0],'rd '+'abcd'[i],a[1],a[2]))});\n    deck.appendChild(acts);main.appendChild(deck);\n  }\n  if(cfg.pills){var p=el('div','pills');cfg.pills.forEach(function(a){p.appendChild(key(a[0],'pill',a[1]))});main.appendChild(p)}\n  if(cfg.hint)main.appendChild(el('div','hint',cfg.hint));\n  card.appendChild(main);wrap.appendChild(card);document.body.appendChild(wrap);envolucro=wrap;\n  // Segunda camada da trava: navegadores antigos ignoram touch-action.\n  stage.addEventListener('touchmove',function(e){e.preventDefault()},{passive:f