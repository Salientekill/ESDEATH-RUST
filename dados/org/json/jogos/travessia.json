255)*(1-f)).toString(16)).slice(-2)}).join('')}\n// `clear` deixou de ser cor chapada: o fundo desce para uma versão mais escura\n// de si mesmo. Um jogo que só passa uma cor ganha profundidade sem saber.\napi.clear=function(c){c=c||'#080b0d';\n var g=cx.createLinearGradient(0,0,0,H);\n g.addColorStop(0,c);g.addColorStop(1,escuro(c,.42));\n cx.fillStyle=g;cx.fillRect(0,0,W,H)};\n// Chanfro de 1px em cima e embaixo: é como pixel art sombreia, e cai bem tanto\n// em tijolo e plataforma quanto em barra de HUD.\napi.box=function(x,y,w,h,c){cx.fillStyle=c;cx.fillRect(x,y,w,h);\n if(w>3&&h>3){cx.fillStyle='rgba(255,255,255,.14)';cx.fillRect(x,y,w,1);\n  cx.fillStyle='rgba(0,0,0,.2)';cx.fillRect(x,y+h-1,w,1)}};\n// Pixel art a partir de um mapa de texto: cada caractere é um pixel, '.' é\n// vazio. É assim que os originais são desenhados, e cabe em poucas linhas —\n// desenhar o invasor com retângulo solto é o que faz parecer imitação.\napi.sprite=function(x,y,s,mapa,cores){\n for(var r=0;r<mapa.length;r++){var lin=mapa[r];\n  for(var c=0;c<lin.length;c++){var k=lin.charAt(c);\n   if(k==='.'||k===' ')continue;\n   cx.fillStyle=cores[k]||cores['X']||'#fff';\n   cx.fillRect(x+c*s,y+r*s,s,s)}}};\n// Vidas: 11 jogos escreviam ❤️, que e emoji com seletor de variacao — em parte\n// dos aparelhos sai como glifo de TEXTO (preto e chapado) e em outros nem sai.\n// Quantas vidas restam nao pode depender da fonte do celular.\nvar CORACAO=[\".XX.XX.\",\"XXXXXXX\",\"XXXXXXX\",\"XXXXXXX\",\".XXXXX.\",\"..XXX..\",\"...X...\"];\napi.vidas=function(n,x,y,c,s){s=s||2;\n for(var i=0;i<n;i++)api.sprite(x+i*(7*s+3),y,s,CORACAO,{X:c||'#ff4757'})};\napi.txt=function(s,x,y,c,sz,al){cx.fillStyle=c||'#fff';cx.font='800 '+(sz||14)+'px system-ui';cx.textAlign=al||'center';cx.fillText(s,x,y);cx.textAlign='left'};\n// Brilho no alto à esquerda transforma o disco chapado em esfera. Vale para\n// bola, inimigo, moeda — tudo que os jogos desenham com `circ`.\napi.circ=function(x,y,r,c){cx.fillStyle=c;cx.beginPath();cx.arc(x,y,r,0,6.284);cx.fill();\n if(r>3.5){var g=cx.createRadialGradient(x-r*.34,y-r*.34,r*.08,x,y,r);\n  g.addColorStop(0,'rgba(255,255,255,.3)');g.addColorStop(.55,'rgba(255,255,255,.06)');\n  g.addColorStop(1,'rgba(0,0,0,.16)');\n  cx.fillStyle=g;cx.beginPath();cx.arc(x,y,r,0,6.284);cx.fill()}};\n// Toque direto na tela do jogo (mira, seleção): devolve coordenadas do canvas.\napi.touch=function(f){var t=C.dom?document.getElementById('board'):cv;\n  t.addEventListener('pointerdown',function(e){e.preventDefault();\n    var r=t.getBoundingClientRect();f((e.clientX-r.left)/r.width*W,(e.clientY-r.top)/r.height*H,e)})};\napi.load=load;api.save=save;\napi.rnd=function(n){return Math.random()*n};\napi.ri=function(n){return Math.floor(Math.random()*n)};\nreturn api;})();\nvar fx,fy,carros,toras,casas,pts,vidas,lvl,tempo,noTora,melhor;\nvar CS=24;\n// O sapo do arcade: olhos saltados em cima, quatro patas abertas. Emoji era o\n// que mais denunciava imitação — muda de fonte em cada aparelho e não tem nada\n// a ver com o desenho original.\nvar SAPO=[\".XX......XX.\",\".XWX....XWX.\",\"..XXXXXXXX..\",\".XXXXXXXXXX.\",\n \"XX.XXXXXX.XX\",\"XXXXXXXXXXXX\",\"XXXXXXXXXXXX\",\"XX.XXXXXX.XX\",\n \".XXXXXXXXXX.\",\"..XXXXXXXX..\",\".XX......XX.\",\"XXX......XXX\"];\nHZ.boot({titulo:\"🐸 Travessia\",w:360,h:336,best:\"travessia\",hud:[\"PONTOS\",\"RECORDE\"],pad:\"4\",\n padTxt:\"um salto por toque\",pills:[[\"START\",\"REINICIAR\",\"recomeçar do zero\"]],\n ajuda:\"Leve o sapo até uma das 5 tocas verdes no topo: primeiro atravesse a estrada sem ser atropelado, depois o rio pulando de tronco em tronco (a água mata). Encha as 5 tocas para passar de fase. Dica: o tronco te arrasta — não deixe ele te levar para fora da tela.\",\n hint:\"Cada toque nas setas dá um salto · atravesse a estrada, depois o rio em cima dos troncos\",start:novo});\nfunction novo(){pts=0;vidas=4;lvl=1;melhor=12;casas=[0,0,0,0,0];fase()}\nfunction fase(){carros=[];toras=[];\n var v=1+lvl*.28;\n for(var i=0;i<5;i++){var d=i%2?1:-1,n=i==2?2:3;\n  for(var k=0;k<n;k++)carros.push({y:8+i,x:k*(360/n)+HZ.rnd(40),v:d*v*(.7+i*.16),w:i==2?46:30,c:[\"#ff4757\",\"#ffa502\",\"#e84393\",\"#00cec9\",\"#fdcb6e\"][i]})}\n for(var i=0;i<4;i++){var d=i%2?1:-1,n=2+(i%2);\n  for(var k=0;k<n;k++)toras.push({y:2+i,x:k*(360/n)+HZ.rnd(30),v:d*(v*.6+.3),w:i%2?86:64,t:i%2})}\n reset()}\nfunction reset(){fx=168;fy=12;tempo=520;noTora=null;HZ.play()}\nHZ.on(\"START\",novo);\nfunction morre(m){vidas--;HZ.beep(110,.3,\"sawtooth\");\n if(vidas<=0){HZ.record(pts);HZ.over(\"FIM DE JOGO\",m+\"\\nFase \"+lvl+\" · \"+pts+\" pontos\")}else reset()}\nHZ.loop(function(dt){var W=HZ.W,H=HZ.H;HZ.clear(\"#0a1020\");\n HZ.box(0,2*CS,W,4*CS,\"#123a6b\");HZ.box(0,7*CS,W,CS,\"#1e272e\");HZ.box(0,8*CS,W,5*CS,\"#2d3436\");HZ.box(0,12*CS,W,CS,\"#1e272e\");HZ.box(0,CS,W,CS,\"#1e272e\");\n HZ.box(0,0,W,CS,\"#16321f\");\n for(var i=0;i<5;i++){var hx=12+i*68;HZ.box(hx,2,44,CS-4,casas[i]?\"#2ed573\":\"#0b1a12\");\n  if(casas[i])HZ.sprite(hx+16,4,1,SAPO,{X:\"#1d7a4a\",W:\"#c8f7d4\"})}\n if(!HZ.paused()){\n  tempo-=dt;if(tempo<=0){morre(\"O tempo acabou.\");return}\n  var mv=0;\n  if(HZ.tap(\"U\")){fy--;pts+=2;mv=1}if(HZ.tap(\"D\")&&fy<12){fy++;mv=1}\n  if(HZ.tap(\"L\")){fx-=CS;mv=1}if(HZ.tap(\"R\")){fx+=CS;mv=1}\n  if(mv){HZ.beep(600,.05);HZ.hud(\"PONTOS\",pts)}\n  fx=Math.max(0,Math.min(W-CS,fx));\n  carros.forEach(function(c){c.x+=c.v*dt;if(c.v>0&&c.x>W)c.x=-c.w;if(c.v<0&&c.x<-c.w)c.x=W});\n  toras.forEach(function(t){t.x+=t.v*dt;if(t.v>0&&t.x>W)t.x=-t.w;if(t.v<0&&t.x<-t.w)t.x=W});\n  if(fy>=8&&fy<=12){for(var i=0;i<carros.length;i++){var c=carros[i];\n   if(c.y==fy&&fx+CS-4>c.x&&fx+4<c.x+c.w){morre(\"Você foi atropelado.\");return}}}\n  if(fy>=2&&fy<=5){\n   var em=null;toras.forEach(function(t){if(t.y==fy&&fx+12>t.x&&fx+12<t.x+t.w)em=t});\n   if(!em){morre(\"Você caiu na água.\");return}\n   fx+=em.v*dt;if(fx<-10||fx>W){morre(\"Você foi levado pela correnteza.\");return}}\n  if(fy<=0){\n   var s=Math.round((fx-12)/68);\n   if(s>=0&&s<5&&!casas[s]&&Math.abs(12+s*68-fx+10)<26){casas[s]=1;pts+=60+Math.floor(tempo/8);HZ.hud(\"PONTOS\",pts);HZ.beep(1200,.15);\n    if(casas.every(function(x){return x})){lvl++;pts+=200;casas=[0,0,0,0,0];HZ.hud(\"PONTOS\",pts);fase();return}\n    reset()}\n   else{morre(\"Não tem toca aí.\");return}}\n }\n toras.forEach(function(t){HZ.cx.fillStyle=t.t?\"#0e7c5a\":\"#8b5a2b\";\n  HZ.cx.fillRect(t.x,t.y*CS+4,t.w,CS-8);\n  if(t.t)for(var k=0;k<3;k++)HZ.circ(t.x+16+k*26,t.y*CS+CS/2,7,\"#13a077\")});\n carros.forEach(function(c){HZ.box(c.x,c.y*CS+4,c.w,CS-8,c.c);HZ.box(c.x+4,c.y*CS+7,c.w-8,5,\"rgba(0,0,0,.35)\")});\n HZ.sprite(fx+6,fy*CS+6,1,SAPO,{X:\"#2ed573\",W:\"#fff\"});\n HZ.box(4,H-5,Math.max(0,tempo/520)*(W-8),3,tempo<140?\"#ff4757\":\"#2ed573\");\n HZ.txt(\"FASE \"+lvl+\"   VIDAS \"+vidas,W/2,H-9,\"rgba(255,255,255,.6)\",10);\n});\nnovo();HZ.over(\"TRAVESSIA\",\"Leve 5 sapos até as tocas verdes do topo.\\nNa água só o tronco salva — e ele te arrasta junto.\");\n</script></body>"}