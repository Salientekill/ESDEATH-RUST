(pac.c);\n  if(i==\".\"||i==\"o\"){G[pac.r]=G[pac.r].substring(0,pac.c)+\" \"+G[pac.r].substring(pac.c+1);dots--;\n   pts+=i==\"o\"?50:10;HZ.hud(\"PONTOS\",pts);HZ.beep(i==\"o\"?520:880,.04);\n   if(i==\"o\"){pw=380;gh.forEach(function(g){if(g.out){g.fr=1;g.d=(g.d+2)%4}})}\n   if(!dots){lvl++;fase();return}}\n  gh.forEach(function(g){\n   if(!g.out){if(g.dly>0){g.dly-=dt}else{g.out=1;g.c=9;g.r=7;g.x=9;g.y=7}return}\n   ia(g);mover(g,g.fr?sp*.55:sp*(.86+lvl*.02),0);\n   if(Math.abs(g.x-pac.x)<.6&&Math.abs(g.y-pac.y)<.6){\n    if(g.fr){pts+=200;HZ.hud(\"PONTOS\",pts);HZ.beep(1100,.12);\n     HZ.part(OX+g.x*CS+CS/2,OY+g.y*CS+CS/2,\"#7ee8fa\",12,2.6);g.fr=0;g.out=0;g.dly=120;g.c=9;g.r=9;g.x=9;g.y=9}\n    else{HZ.record(pts);HZ.beep(120,.4,\"sawtooth\");HZ.over(\"GAME OVER\",\"Fase \"+lvl+\" · \"+pts+\" pontos\")}}});\n }\n // labirinto\n for(var r=0;r<ROW;r++)for(var c=0;c<COL;c++){var x=cel(c,r),px=OX+c*CS,py=OY+r*CS;\n  if(x==\"#\"){HZ.cx.fillStyle=\"#1b2f8a\";HZ.cx.fillRect(px+2,py+2,CS-4,CS-4)}\n  else if(x==\"=\")HZ.box(px+2,py+7,CS-4,3,\"#ffb8de\");\n  else if(x==\".\")HZ.circ(px+CS/2,py+CS/2,2,\"#ffd479\");\n  else if(x==\"o\")HZ.circ(px+CS/2,py+CS/2,5,\"#fff\")}\n var a=(Date.now()/70%10<5?.28:.02)*Math.PI;\n HZ.cx.fillStyle=\"#ffdd33\";HZ.cx.beginPath();\n HZ.cx.arc(OX+pac.x*CS+CS/2,OY+pac.y*CS+CS/2,CS/2-1,pac.d*1.5708+a,pac.d*1.5708-a+6.283);\n HZ.cx.lineTo(OX+pac.x*CS+CS/2,OY+pac.y*CS+CS/2);HZ.cx.fill();\n gh.forEach(function(g){\n  var gx=OX+g.x*CS,gy=OY+g.y*CS,f=Math.floor(Date.now()/160)%2;\n  if(g.fr){var pisca=pw<70&&Math.floor(Date.now()/120)%2;\n   HZ.sprite(gx,gy,CS/12,GH_MEDO,{X:pisca?\"#fff\":\"#2a44ff\",W:pisca?\"#ff4757\":\"#ffd479\"})}\n  else HZ.sprite(gx,gy,CS/12,GH[f],{X:g.col,W:\"#fff\",P:\"#2a44ff\"})});\n HZ.txt(\"FASE \"+lvl,W/2,12,\"rgba(255,255,255,.55)\",10);\n if(ready>0)HZ.txt(ready>0?\"PRONTO!\":\"\",W/2,OY+11*CS,\"#ffd479\",18);\n});\nfunction mover(o,sp,ehPac){\n var pc=Math.abs(o.x-o.c)<.06&&Math.abs(o.y-o.r)<.06;\n if(pc){o.x=o.c;o.y=o.r;\n  if(ehPac&&livre(o.c+DX[o.nd],o.r+DY[o.nd]))o.d=o.nd;\n  if(!livre(o.c+DX[o.d],o.r+DY[o.d]))return;\n  o.c+=DX[o.d];o.r+=DY[o.d];tp(o)}\n o.x+=Math.sign(o.c-o.x)*Math.min(sp*dt2(),Math.abs(o.c-o.x));\n o.y+=Math.sign(o.r-o.y)*Math.min(sp*dt2(),Math.abs(o.r-o.y));\n}\nvar _dt=1;function dt2(){return _dt}\nfunction ia(g){\n if(Math.abs(g.x-g.c)>.06||Math.abs(g.y-g.r)>.06)return;\n var alvo;\n if(g.fr)alvo=[HZ.ri(COL),HZ.ri(ROW)];\n else if(mode)alvo=[[0,0],[COL-1,0],[0,ROW-1],[COL-1,ROW-1]][g.t];\n else if(g.t==0)alvo=[pac.c,pac.r];\n else if(g.t==1)alvo=[pac.c+DX[pac.d]*4,pac.r+DY[pac.d]*4];\n else if(g.t==2)alvo=[pac.c+DX[pac.d]*2,pac.r+DY[pac.d]*2];\n else alvo=Math.hypot(g.c-pac.c,g.r-pac.r)>5?[pac.c,pac.r]:[0,ROW-1];\n var melhor=-1,bd=1e9;\n for(var d=0;d<4;d++){if(d==(g.d+2)%4)continue;\n  var nc=g.c+DX[d],nr=g.r+DY[d];if(!livre(nc,nr))continue;\n  var dd=Math.hypot(nc-alvo[0],nr-alvo[1]);if(dd<bd){bd=dd;melhor=d}}\n if(melhor>=0)g.d=melhor;else g.d=(g.d+2)%4;\n}\nnovo();HZ.over(\"COMILÃO\",\"Coma os 150 pontinhos sem encostar nos fantasmas.\\nAs 4 pastilhas grandes deixam eles azuis por alguns segundos.\");\n</script></body>"}