{"titulo": "💣 Bombas", "html": "<style>*{-webkit-tap-highlight-color:transparent;-webkit-user-select:none;user-select:none;-webkit-touch-callout:none;box-sizing:border-box;margin:0}\nhtml,body{overscroll-behavior:none;-webkit-overflow-scrolling:auto}\nbody{background:transparent;font-family:-apple-system,'Segoe UI',Roboto,Arial,sans-serif;color:#e8edf0}\n.wrap{width:100%;max-width:620px;margin:auto;padding:12px}\n.card{background:rgba(20,25,29,.985);border:1px solid rgba(255,255,255,.13);border-radius:16px;overflow:hidden;box-shadow:0 8px 34px rgba(0,0,0,.45)}\n.head{padding:10px 14px;border-bottom:1px solid rgba(255,255,255,.09);display:flex;justify-content:space-between;align-items:center;gap:10px}\n.brand{font-size:9px;letter-spacing:1.7px;color:rgba(255,255,255,.34)}\n.title{font-size:17px;font-weight:900;color:#fff;line-height:1.2}\n.hud{display:flex;gap:13px;text-align:right;flex-shrink:0}\n.lab{font-size:8px;letter-spacing:1px;color:rgba(255,255,255,.42)}\n.val{font:800 16px ui-monospace,'Courier New',monospace;color:#ffd479;white-space:nowrap}\n.main{padding:12px}\n.stage{position:relative;touch-action:none;-ms-touch-action:none}\ncanvas{display:block;width:100%;height:auto;background:#080b0d;border:1px solid rgba(255,255,255,.1);border-radius:12px;touch-action:none}\n#board{touch-action:none}\n.msg{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6px;background:rgba(5,8,10,.86);border-radius:12px;text-align:center;padding:16px}\n.msg.off{display:none}\n.msg b{font-size:19px;color:#fff;letter-spacing:.5px}\n.msg span{font-size:12px;color:rgba(255,255,255,.62);line-height:1.5;max-width:88%}\n.deck{margin-top:11px;display:flex;justify-content:space-between;align-items:center;gap:12px;touch-action:none}\n.dpad{display:grid;grid-template-columns:repeat(3,44px);grid-template-rows:repeat(3,44px);gap:5px;flex-shrink:0}\n.dpad.h{grid-template-rows:44px}\n.dpad.v{grid-template-columns:44px}\n.k{border:1px solid rgba(255,255,255,.17);background:rgba(255,255,255,.085);color:#fff;border-radius:12px;font:800 16px system-ui;display:flex;align-items:center;justify-content:center;touch-action:none;padding:0;line-height:1;transition:transform .05s,background .05s}\n.k.on{background:rgba(255,255,255,.3);transform:scale(.93)}\n.k.sp{visibility:hidden}\n.acts{display:flex;gap:9px;align-items:center;flex-wrap:wrap;justify-content:flex-end}\n.k.rd{width:62px;height:62px;border-radius:50%;font-size:15px;flex-direction:column;gap:1px}\n.k.rd small{font-size:7px;letter-spacing:.6px;opacity:.75;font-weight:700}\n.k.a{background:#d8394f;border-color:#ff7f92}\n.k.b{background:#2f6fe4;border-color:#79a5ff}\n.k.c{background:#1f9d63;border-color:#67d9a0}\n.k.d{background:#8a52d6;border-color:#b892f0}\n.pills{display:flex;gap:8px;justify-content:center;margin-top:10px;flex-wrap:wrap}\n.k.pill{padding:10px 18px;border-radius:20px;font:800 11px system-ui;letter-spacing:1.2px;min-width:78px}\n.hint{text-align:center;margin-top:9px;font-size:11px;color:rgba(255,255,255,.48);line-height:1.45}\n.grid{display:grid;gap:5px;touch-action:none}\n.cell{border:1px solid rgba(255,255,255,.12);background:rgba(255,255,255,.05);border-radius:8px;display:flex;align-items:center;justify-content:center;font-weight:800;touch-action:none}</style><body><script>var HZ=(function(){\nvar api={},C={},cv,cx,msg,hudEl,parts=[],shakeN=0,vinh=null,held={},tap={},press={},W=0,H=0,tickFn=null,raf=0,prev=0,ac=null,paused=1;\nfunction el(t,c,h){var e=document.createElement(t);if(c)e.className=c;if(h!=null)e.innerHTML=h;return e}\nfunction key(id,cls,label,sub){\n  var b=el('button','k '+cls,label+(sub?'<small>'+sub+'</small>':''));\n  b.setAttribute('type','button');\n  // Deixa o id do botao legivel de fora: a auditoria cruza isto com os\n  // `HZ.on`/`HZ.held` do jogo para achar entrada que nunca dispara.\n  b.dataset.hz=id;\n  // Trava de rolagem: sem preventDefault no pointerdown o webview do WhatsApp\n  // interpreta o arrasto no botao como scroll do chat e o jogo fica injogavel.\n  b.addEventListener('pointerdown',function(e){e.preventDefault();e.stopPropagation();hold(id,1);b.classList.add('on')});\n  var up=function(e){if(e)e.preventDefault();hold(id,0);b.classList.remove('on')};\n  b.addEventListener('pointerup',up);b.addEventListener('pointercancel',up);b.addEventListener('pointerleave',up);\n  b.addEventListener('contextmenu',function(e){e.preventDefault()});\n  return b;\n}\nfunction hold(id,v){\n  if(v){if(!held[id]){tap[id]=1;if(press[id])press[id]()}held[id]=1}else held[id]=0;\n}\nvar ARROW={U:'&#9650;',D:'&#9660;',L:'&#9664;',R:'&#9654;'};\nfunction pad(kind){\n  var d=el('div','dpad'+(kind=='h'?' h':kind=='v'?' v':''));\n  var slots=kind=='h'?['L','R']:kind=='v'?['U','D']:['sp','U','sp','L','sp','R','sp','D','sp'];\n  slots.forEach(function(s){ d.appendChild(s=='sp'?el('button','k sp',''):key(s,'',ARROW[s])); });\n  return d;\n}\nfunction boot(cfg){\n  C=cfg;\n  var wrap=el('div','wrap'),card=el('div','card');\n  var head=el('div','head');\n  head.appendChild(el('div','','<div class=\"brand\">HIURA ARCADE</div><div class=\"title\">'+cfg.titulo+'</div>'));\n  hudEl=el('div','hud');\n  (cfg.hud||[]).forEach(function(l){hudEl.appendChild(el('div','','<div class=\"lab\">'+l+'</div><div class=\"val\" id=\"hv'+l+'\">0</div>'))});\n  head.appendChild(hudEl);card.appendChild(head);\n  var main=el('div','main'),stage=el('div','stage');\n  if(cfg.dom){var bd=el('div','',' ');bd.id='board';stage.appendChild(bd)}\n  else{cv=el('canvas');cv.id='cv';cv.width=W=cfg.w||360;cv.height=H=cfg.h||300;stage.appendChild(cv);cx=cv.getContext('2d')}\n  msg=el('div','msg');stage.appendChild(msg);main.appendChild(stage);\n  if(cfg.pad||cfg.acts){\n    var deck=el('div','deck');\n    deck.appendChild(cfg.pad?pad(cfg.pad):el('div','',''));\n    var acts=el('div','acts');\n    (cfg.acts||[]).forEach(function(a,i){acts.appendChild(key(a[0],'rd '+'abcd'[i],a[1],a[2]))});\n    deck.appendChild(acts);main.appendChild(deck);\n  }\n  if(cfg.pills){var p=el('div','pills');cfg.pills.forEach(function(a){p.appendChild(key(a[0],'pill',a[1]))});main.appendChild(p)}\n  if(cfg.hint)main.appendChild(el('div','hint',cfg.hint));\n  card.appendChild(main);wrap.appendChild(card);document.body.appendChild(wrap);\n  // Segunda camada da trava: navegadores antigos ignoram touch-action.\n  stage.addEventListener('touchmove',function(e){e.preventDefault()},{passive:false});\n  document.querySelectorAll('.deck,.pills').forEach(function(n){\n    n.addEventListener('touchmove',function(e){e.preventDefault()},{passive:false})});\n  if(cfg.keys!==false)document.addEventListener('keydown',function(e){\n    var m={ArrowUp:'U',ArrowDown:'D',ArrowLeft:'L',ArrowRight:'R',KeyW:'U',KeyS:'D',KeyA:'L',KeyD:'R',Space:'A',KeyZ:'A',KeyX:'B',Enter:'START'};\n    if(m[e.code]){e.preventDefault();hold(m[e.code],1)}});\n  if(cfg.keys!==false)document.addEventListener('keyup',function(e){\n    var m={ArrowUp:'U',ArrowDown:'D',ArrowLeft:'L',ArrowRight:'R',KeyW:'U',KeyS:'D',KeyA:'L',KeyD:'R',Space:'A',KeyZ:'A',KeyX:'B',Enter:'START'};\n    if(m[e.code])hold(m[e.code],0)});\n  if(cfg.best)api.best=+(load(cfg.best)||0),api.hud(cfg.hud&&cfg.hud[cfg.hud.length-1]||'BEST',api.best);\n  return api;\n}\nfunction load(k){try{return localStorage.getItem('hz_'+k)}catch(e){return null}}\nfunction save(k,v){try{localStorage.setItem('hz_'+k,v)}catch(e){}}\napi.boot=boot;\napi.hud=function(l,v){var e=document.getElementById('hv'+l);if(e)e.textContent=v};\napi.best=0;\napi.record=function(v){if(v>api.best){api.best=v;if(C.best)save(C.best,v);\n api.hud(C.hud&&C.hud[C.hud.length-1]||'BEST',v);\n if(cx)api.part(W-40,14,'#ffd479',8,2.2);\n return 1}return 0};\napi.held=function(k){return !!held[k]};\napi.tap=function(k){var v=tap[k];tap[k]=0;return !!v};\napi.on=function(k,f){press[k]=f};\napi.over=function(t,s,btn){paused=1;api.shake(9);msg.className='msg';msg.innerHTML='<b>'+t+'</b>'+(s?'<span>'+s+'</span>':'');\n  if(btn!==false){var b=el('button','k pill',btn||'JOGAR');b.style.marginTop='10px';\n    b.addEventListener('pointerdown',function(e){e.preventDefault();if(C.start)C.start()});msg.appendChild(b)}};\napi.play=function(){msg.className='msg off';paused=0};\napi.paused=function(){return paused};\napi.loop=function(f){tickFn=f;if(!raf){prev=0;raf=requestAnimationFrame(step)}};\n// Tremida vai no `transform` do CANVAS, nao no contexto: transladar o contexto\n// deixaria uma faixa vazia na borda em todo jogo que pinta o fundo com\n// `fillRect(0,0,W,H)` em vez do `HZ.clear`.\napi.shake=function(n){shakeN=Math.max(shakeN,n||7)};\napi.part=function(x,y,c,n,v){\n for(var i=0;i<(n||10);i++){var a=Math.random()*6.2832,s=(v||2.4)*(.35+Math.random());\n  parts.push({x:x,y:y,vx:Math.cos(a)*s,vy:Math.sin(a)*s-.6,c:c||'#fff',t:1,r:1.4+Math.random()*2.2})}};\nfunction step(t){raf=requestAnimationFrame(step);\n var ms=prev?Math.min(50,t-prev):16;prev=t;var d=ms/16.667;\n if(tickFn)tickFn(d,t);\n if(cx){if(!vinh){vinh=cx.createRadialGradient(W/2,H*.45,Math.min(W,H)*.3,W/2,H*.5,Math.max(W,H)*.75);\n   vinh.addColorStop(0,'rgba(0,0,0,0)');vinh.addColorStop(.65,'rgba(0,0,0,.1)');\n   vinh.addColorStop(1,'rgba(0,0,0,.34)')}\n  cx.fillStyle=vinh;cx.fillRect(0,0,W,H)}\n if(cx&&parts.length)parts=parts.filter(function(p){\n  p.x+=p.vx*d;p.y+=p.vy*d;p.vy+=.14*d;p.t-=.028*d;\n  if(p.t<=0)return 0;\n  cx.globalAlpha=Math.min(1,p.t);cx.fillStyle=p.c;\n  cx.fillRect(p.x-p.r,p.y-p.r,p.r*2,p.r*2);cx.globalAlpha=1;return 1});\n if(shakeN>.4){shakeN*=.86;\n  if(cv)cv.style.transform='translate('+((Math.random()-.5)*shakeN).toFixed(1)+'px,'\n   +((Math.random()-.5)*shakeN).toFixed(1)+'px)'}\n else if(shakeN){shakeN=0;if(cv)cv.style.transform=''}}\napi.beep=function(f,d,type){\n  try{if(!ac)ac=new (window.AudioContext||window.webkitAudioContext)();\n  var o=ac.createOscillator(),g=ac.createGain();o.type=type||'square';o.frequency.value=f;\n  g.gain.value=.05;o.connect(g);g.connect(ac.destination);o.start();\n  g.gain.exponentialRampToValueAtTime(.001,ac.currentTime+(d||.08));o.stop(ac.currentTime+(d||.08))}catch(e){}};\nObject.defineProperty(api,'cx',{get:function(){return cx}});\nObject.defineProperty(api,'cv',{get:function(){return cv}});\nObject.defineProperty(api,'W',{get:function(){return W}});\nObject.defineProperty(api,'H',{get:function(){return H}});\n// Escurece uma cor #rrggbb por um fator. Serve para derivar o pé do gradiente\n// do fundo a partir da única cor que o jogo informa.\nfunction escuro(c,f){\n if(!/^#[0-9a-fA-F]{6}$/.test(c))return c;\n var n=parseInt(c.slice(1),16);\n return '#'+[16,8,0].map(function(s){\n  return ('0'+Math.round(((n>>s)&255)*(1-f)).toString(16)).slice(-2)}).join('')}\n// `clear` deixou de ser cor chapada: o fundo desce para uma versão mais escura\n// de si mesmo. Um jogo que só passa uma cor ganha profundidade sem saber.\napi.clear=function(c){c=c||'#080b0d';\n var g=cx.createLinearGradient(0,0,0,H);\n g.addColorStop(0,c);g.addColorStop(1,escuro(c,.42));\n cx.fillStyle=g;cx.fillRect(0,0,W,H)};\n// Chanfro de 1px em cima e embaixo: é como pixel art sombreia, e cai bem tanto\n// em tijolo e plataforma quanto em barra de HUD.\napi.box=function(x,y,w,h,c){cx.fillStyle=c;cx.fillRect(x,y,w,h);\n if(w>3&&h>3){cx.fillStyle='rgba(255,255,255,.14)';cx.fillRect(x,y,w,1);\n  cx.fillStyle='rgba(0,0,0,.2)';cx.fillRect(x,y+h-1,w,1)}};\napi.txt=function(s,x,y,c,sz,al){cx.fillStyle=c||'#fff';cx.font='800 '+(sz||14)+'px system-ui';cx.textAlign=al||'center';cx.fillText(s,x,y);cx.textAlign='left'};\n// Brilho no alto à esquerda transforma o disco chapado em esfera. Vale para\n// bola, inimigo, moeda — tudo que os jogos desenham com `circ`.\napi.circ=function(x,y,r,c){cx.fillStyle=c;cx.beginPath();cx.arc(x,y,r,0,6.284);cx.fill();\n if(r>3.5){var g=cx.createRadialGradient(x-r*.34,y-r*.34,r*.08,x,y,r);\n  g.addColorStop(0,'rgba(255,255,255,.3)');g.addColorStop(.55,'rgba(255,255,255,.06)');\n  g.addColorStop(1,'rgba(0,0,0,.16)');\n  cx.fillStyle=g;cx.beginPath();cx.arc(x,y,r,0,6.284);cx.fill()}};\n// Toque direto na tela do jogo (mira, seleção): devolve coordenadas do canvas.\napi.touch=function(f){var t=C.dom?document.getElementById('board'):cv;\n  t.addEventListener('pointerdown',function(e){e.preventDefault();\n    var r=t.getBoundingClientRect();f((e.clientX-r.left)/r.width*W,(e.clientY-r.top)/r.height*H,e)})};\napi.load=load;api.save=save;\napi.rnd=function(n){return Math.random()*n};\napi.ri=function(n){return Math.floor(Math.random()*n)};\nreturn api;})();\nvar CS=22,COLS=15,LINS=11,OX=15,OY=14;\nvar g,p,bombas,chamas,inim,pts,vidas,lvl,alc,maxb,saida,pu;\nHZ.boot({titulo:\"💣 Bombas\",w:360,h:322,best:\"bomba\",hud:[\"PONTOS\",\"RECORDE\"],pad:\"4\",\n acts:[[\"A\",\"💣\",\"BOMBA\"]],pills:[[\"START\",\"REINICIAR\"]],\n hint:\"Setas andam · A larga bomba · quebre os blocos, ache a saída e fuja da explosão\",start:novo});\nfunction novo(){pts=0;vidas=3;lvl=1;alc=1;maxb=1;HZ.hud(\"PONTOS\",0);fase()}\nfunction fase(){g=[];\n for(var r=0;r<LINS;r++){g.push([]);for(var c=0;c<COLS;c++){\n  var v=0;\n  if(r==0||c==0||r==LINS-1||c==COLS-1||(r%2==0&&c%2==0))v=1;\n  else if(HZ.rnd(1)<.42)v=2;\n  if((r<3&&c<3)||(r<2&&c<4)||(r<4&&c<2))v=v==2?0:v;\n  g[r].push(v)}}\n var q=[];for(var r=1;r<LINS-1;r++)for(var c=1;c<COLS-1;c++)if(g[r][c]==2)q.push([r,c]);\n saida=q.length?q[HZ.ri(q.length)]:[1,1];\n pu=q.length>2?q[HZ.ri(q.length)]:null;\n p={c:1,r:1,x:1,y:1};bombas=[];chamas=[];inim=[];\n for(var i=0;i<2+lvl;i++){var t=0,rr,cc;\n  do{rr=1+HZ.ri(LINS-2);cc=1+HZ.ri(COLS-2)}while((g[rr][cc]||(rr<5&&cc<5))&&++t<80);\n  inim.push({c:cc,r:rr,x:cc,y:rr,d:HZ.ri(4),v:.026+lvl*.004})}\n HZ.play()}\nvar DX=[0,1,0,-1],DY=[-1,0,1,0];\nHZ.on(\"START\",novo);\nHZ.on(\"A\",function(){if(HZ.paused()||bombas.length>=maxb)return;\n if(bombas.some(function(b){return b.c==p.c&&b.r==p.r}))return;\n bombas.push({c:p.c,r:p.r,t:130});HZ.beep(300,.08)});\nfunction explode(b){HZ.beep(140,.22,\"sawtooth\");HZ.shake(8);\n HZ.part(OX+b.c*CS+CS/2,OY+b.r*CS+CS/2,\"#ff9f43\",18,3.2);\n var cels=[[b.r,b.c]];\n for(var d=0;d<4;d++)for(var i=1;i<=alc+1;i++){\n  var r=b.r+DY[d]*i,c=b.c+DX[d]*i;\n  if(g[r]===undefined||g[r][c]===undefined||g[r][c]==1)break;\n  cels.push([r,c]);\n  if(g[r][c]==2){g[r][c]=0;pts+=10;HZ.hud(\"PONTOS\",pts);\n   if(saida[0]==r&&saida[1]==c)g[r][c]=3;\n   if(pu&&pu[0]==r&&pu[1]==c)g[r][c]=4;\n   break}}\n cels.forEach(function(k){chamas.push({r:k[0],c:k[1],t:26})});\n bombas.forEach(function(o){if(o!=b&&o.t>8&&cels.some(function(k){return k[0]==o.r&&k[1]==o.c}))o.t=4})}\nHZ.loop(function(dt){var W=HZ.W,H=HZ.H;HZ.clear(\"#0d1117\");\n if(!HZ.paused()){\n  var mv=.09*dt;\n  if(HZ.held(\"U\")&&pode(p.c,p.r-1))p.r-=0,p.y-=mv;\n  if(HZ.held(\"D\")&&pode(p.c,p.r+1))p.y+=mv;\n  if(HZ.held(\"L\")&&pode(p.c-1,p.r))p.x-=mv;\n  if(HZ.held(\"R\")&&pode(p.c+1,p.r))p.x+=mv;\n  if(HZ.held(\"U\")&&!pode(p.c,p.r-1))p.y=Math.max(p.y,p.r);\n  if(HZ.held(\"D\")&&!pode(p.c,p.r+1))p.y=Math.min(p.y,p.r);\n  if(HZ.held(\"L\")&&!pode(p.c-1,p.r))p.x=Math.max(p.x,p.c);\n  if(HZ.held(\"R\")&&!pode(p.c+1,p.r))p.x=Math.min(p.x,p.c);\n  p.c=Math.round(p.x);p.r=Math.round(p.y);\n  bombas=bombas.filter(function(b){b.t-=dt;if(b.t<=0){explode(b);return 0}return 1});\n  chamas=chamas.filter(function(f){f.t-=dt;return f.t>0});\n  inim.forEach(function(m){\n   var nx=m.x+DX[m.d]*m.v*dt,ny=m.y+DY[m.d]*m.v*dt;\n   if(pode(Math.round(nx+DX[m.d]*.5),Math.round(ny+DY[m.d]*.5))){m.x=nx;m.y=ny}\n   else{m.x=Math.round(m.x);m.y=Math.round(m.y);m.d=HZ.ri(4)}\n   m.c=Math.round(m.x);m.r=Math.round(m.y);\n   if(HZ.rnd(100)<1.2)m.d=HZ.ri(4)});\n  var morto=0;\n  chamas.forEach(function(f){\n   if(f.r==p.r&&f.c==p.c)morto=1;\n   inim=inim.filter(function(m){if(m.r==f.r&&m.c==f.c){pts+=100;HZ.hud(\"PONTOS\",pts);\n    HZ.part(OX+m.x*CS+CS/2,OY+m.y*CS+CS/2,\"#a55eea\",12,2.4);HZ.beep(900,.1);return 0}return 1})});\n  if(inim.some(function(m){return Math.abs(m.x-p.x)<.65&&Math.abs(m.y-p.y)<.65}))morto=1;\n  if(morto){vidas--;HZ.beep(90,.4,\"sawtooth\");\n   if(vidas<=0){HZ.record(pts);HZ.over(\"GAME OVER\",\"Fase \"+lvl+\" · \"+pts+\" pontos\")}\n   else{p={c:1,r:1,x:1,y:1};bombas=[];chamas=[]}}\n  if(g[p.r][p.c]==4){g[p.r][p.c]=0;if(HZ.rnd(1)<.5)alc++;else maxb++;pts+=50;HZ.hud(\"PONTOS\",pts);HZ.beep(1300,.18)}\n  if(g[p.r][p.c]==3&&!inim.length){lvl++;pts+=300;HZ.hud(\"PONTOS\",pts);HZ.beep(1500,.3);fase();return}\n }\n for(var r=0;r<LINS;r++)for(var c=0;c<COLS;c++){var x=OX+c*CS,y=OY+r*CS,v=g[r][c];\n  if(v==1){HZ.box(x,y,CS-1,CS-1,\"#4b5561\");HZ.box(x+2,y+2,CS-5,CS-5,\"#5f6b78\")}\n  else if(v==2){HZ.box(x,y,CS-1,CS-1,\"#8d6e4f\");HZ.box(x+2,y+2,CS-5,4,\"#a58163\")}\n  else{HZ.box(x,y,CS-1,CS-1,\"#18202a\");\n   if(v==3)HZ.txt(\"🚪\",x+CS/2,y+CS-5,\"#fff\",14);\n   if(v==4)HZ.txt(\"⭐\",x+CS/2,y+CS-5,\"#fff\",13)}}\n bombas.forEach(function(b){var s=1+Math.sin(Date.now()/70)*.12;\n  HZ.circ(OX+b.c*CS+CS/2,OY+b.r*CS+CS/2,8*s,\"#1e272e\");HZ.circ(OX+b.c*CS+CS/2-3,OY+b.r*CS+CS/2-3,2,\"#ff4757\")});\n chamas.forEach(function(f){HZ.box(OX+f.c*CS+1,OY+f.r*CS+1,CS-3,CS-3,f.t>16?\"#fff\":\"#ff9f43\")});\n inim.forEach(function(m){HZ.circ(OX+m.x*CS+CS/2,OY+m.y*CS+CS/2,8,\"#a55eea\");\n  HZ.circ(OX+m.x*CS+CS/2-3,OY+m.y*CS+CS/2-2,2,\"#fff\");HZ.circ(OX+m.x*CS+CS/2+3,OY+m.y*CS+CS/2-2,2,\"#fff\")});\n HZ.box(OX+p.x*CS+3,OY+p.y*CS+2,CS-7,CS-5,\"#7ee8fa\");\n HZ.box(OX+p.x*CS+6,OY+p.y*CS+5,3,3,\"#04060a\");HZ.box(OX+p.x*CS+11,OY+p.y*CS+5,3,3,\"#04060a\");\n HZ.txt(\"FASE \"+lvl+\"  VIDAS \"+vidas+\"  💣\"+maxb+\"  ⭐\"+alc+\"  INIMIGOS \"+inim.length,W/2,H-5,\"rgba(255,255,255,.55)\",10);\n});\nfunction pode(c,r){return g[r]!==undefined&&g[r][c]!==undefined&&g[r][c]!=1&&g[r][c]!=2\n &&!bombas.some(function(b){return b.c==c&&b.r==r&&!(c==p.c&&r==p.r)})}\nnovo();HZ.over(\"BOMBAS\",\"Exploda os blocos de madeira: um esconde a saída, outro um power-up.\\nA saída só abre depois de eliminar todos os inimigos.\");\n</script></body>"}