{"titulo": "🚢 Batalha Naval", "html": "<style>*{-webkit-tap-highlight-color:transparent;-webkit-user-select:none;user-select:none;-webkit-touch-callout:none;box-sizing:border-box;margin:0}\nhtml,body{overscroll-behavior:none;-webkit-overflow-scrolling:auto}\nbody{background:transparent;font-family:-apple-system,'Segoe UI',Roboto,Arial,sans-serif;color:#e8edf0}\n.wrap{width:100%;max-width:620px;margin:auto;padding:12px}\n.card{background:rgba(20,25,29,.985);border:1px solid rgba(255,255,255,.13);border-radius:16px;overflow:hidden;box-shadow:0 8px 34px rgba(0,0,0,.45)}\n.head{padding:10px 14px;border-bottom:1px solid rgba(255,255,255,.09);display:flex;justify-content:space-between;align-items:center;gap:10px}\n.brand{font-size:9px;letter-spacing:1.7px;color:rgba(255,255,255,.34)}\n.title{font-size:17px;font-weight:900;color:#fff;line-height:1.2}\n.hud{display:flex;gap:13px;text-align:right;flex-shrink:0}\n.lab{font-size:8px;letter-spacing:1px;color:rgba(255,255,255,.42)}\n.val{font:800 16px ui-monospace,'Courier New',monospace;color:#ffd479;white-space:nowrap}\n.main{padding:12px}\n.stage{position:relative;touch-action:none;-ms-touch-action:none}\ncanvas{display:block;width:100%;height:auto;background:#080b0d;border:1px solid rgba(255,255,255,.1);border-radius:12px;touch-action:none}\n#board{touch-action:none}\n.msg{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6px;background:rgba(5,8,10,.86);border-radius:12px;text-align:center;padding:16px}\n.msg.off{display:none}\n.msg b{font-size:19px;color:#fff;letter-spacing:.5px}\n.msg span{font-size:12px;color:rgba(255,255,255,.62);line-height:1.5;max-width:88%}\n.deck{margin-top:11px;display:flex;justify-content:space-between;align-items:center;gap:12px;touch-action:none}\n.dpad{display:grid;grid-template-columns:repeat(3,44px);grid-template-rows:repeat(3,44px);gap:5px;flex-shrink:0}\n.dpad.h{grid-template-rows:44px}\n.dpad.v{grid-template-columns:44px}\n.k{border:1px solid rgba(255,255,255,.17);background:rgba(255,255,255,.085);color:#fff;border-radius:12px;font:800 16px system-ui;display:flex;align-items:center;justify-content:center;touch-action:none;padding:0;line-height:1;transition:transform .05s,background .05s}\n.k.on{background:rgba(255,255,255,.3);transform:scale(.93)}\n.k.sp{visibility:hidden}\n.acts{display:flex;gap:9px;align-items:center;flex-wrap:wrap;justify-content:flex-end}\n.k.rd{width:62px;height:62px;border-radius:50%;font-size:15px;flex-direction:column;gap:1px}\n.k.rd small{font-size:7px;letter-spacing:.6px;opacity:.75;font-weight:700}\n.k.a{background:#d8394f;border-color:#ff7f92}\n.k.b{background:#2f6fe4;border-color:#79a5ff}\n.k.c{background:#1f9d63;border-color:#67d9a0}\n.k.d{background:#8a52d6;border-color:#b892f0}\n.pills{display:flex;gap:8px;justify-content:center;margin-top:10px;flex-wrap:wrap}\n.k.pill{padding:10px 18px;border-radius:20px;font:800 11px system-ui;letter-spacing:1.2px;min-width:78px}\n.hint{text-align:center;margin-top:9px;font-size:11px;color:rgba(255,255,255,.48);line-height:1.45}\n.grid{display:grid;gap:5px;touch-action:none}\n.cell{border:1px solid rgba(255,255,255,.12);background:rgba(255,255,255,.05);border-radius:8px;display:flex;align-items:center;justify-content:center;font-weight:800;touch-action:none}</style><body><script>var HZ=(function(){\nvar api={},C={},cv,cx,msg,hudEl,parts=[],shakeN=0,vinh=null,held={},tap={},press={},W=0,H=0,tickFn=null,raf=0,prev=0,ac=null,paused=1;\nfunction el(t,c,h){var e=document.createElement(t);if(c)e.className=c;if(h!=null)e.innerHTML=h;return e}\nfunction key(id,cls,label,sub){\n  var b=el('button','k '+cls,label+(sub?'<small>'+sub+'</small>':''));\n  b.setAttribute('type','button');\n  // Deixa o id do botao legivel de fora: a auditoria cruza isto com os\n  // `HZ.on`/`HZ.held` do jogo para achar entrada que nunca dispara.\n  b.dataset.hz=id;\n  // Trava de rolagem: sem preventDefault no pointerdown o webview do WhatsApp\n  // interpreta o arrasto no botao como scroll do chat e o jogo fica injogavel.\n  b.addEventListener('pointerdown',function(e){e.preventDefault();e.stopPropagation();hold(id,1);b.classList.add('on')});\n  var up=function(e){if(e)e.preventDefault();hold(id,0);b.classList.remove('on')};\n  b.addEventListener('pointerup',up);b.addEventListener('pointercancel',up);b.addEventListener('pointerleave',up);\n  b.addEventListener('contextmenu',function(e){e.preventDefault()});\n  return b;\n}\nfunction hold(id,v){\n  if(v){if(!held[id]){tap[id]=1;if(press[id])press[id]()}held[id]=1}else held[id]=0;\n}\nvar ARROW={U:'&#9650;',D:'&#9660;',L:'&#9664;',R:'&#9654;'};\nfunction pad(kind){\n  var d=el('div','dpad'+(kind=='h'?' h':kind=='v'?' v':''));\n  var slots=kind=='h'?['L','R']:kind=='v'?['U','D']:['sp','U','sp','L','sp','R','sp','D','sp'];\n  slots.forEach(function(s){ d.appendChild(s=='sp'?el('button','k sp',''):key(s,'',ARROW[s])); });\n  return d;\n}\nfunction boot(cfg){\n  C=cfg;\n  var wrap=el('div','wrap'),card=el('div','card');\n  var head=el('div','head');\n  head.appendChild(el('div','','<div class=\"brand\">HIURA ARCADE</div><div class=\"title\">'+cfg.titulo+'</div>'));\n  hudEl=el('div','hud');\n  (cfg.hud||[]).forEach(function(l){hudEl.appendChild(el('div','','<div class=\"lab\">'+l+'</div><div class=\"val\" id=\"hv'+l+'\">0</div>'))});\n  head.appendChild(hudEl);card.appendChild(head);\n  var main=el('div','main'),stage=el('div','stage');\n  if(cfg.dom){var bd=el('div','',' ');bd.id='board';stage.appendChild(bd)}\n  else{cv=el('canvas');cv.id='cv';cv.width=W=cfg.w||360;cv.height=H=cfg.h||300;stage.appendChild(cv);cx=cv.getContext('2d')}\n  msg=el('div','msg');stage.appendChild(msg);main.appendChild(stage);\n  if(cfg.pad||cfg.acts){\n    var deck=el('div','deck');\n    deck.appendChild(cfg.pad?pad(cfg.pad):el('div','',''));\n    var acts=el('div','acts');\n    (cfg.acts||[]).forEach(function(a,i){acts.appendChild(key(a[0],'rd '+'abcd'[i],a[1],a[2]))});\n    deck.appendChild(acts);main.appendChild(deck);\n  }\n  if(cfg.pills){var p=el('div','pills');cfg.pills.forEach(function(a){p.appendChild(key(a[0],'pill',a[1]))});main.appendChild(p)}\n  if(cfg.hint)main.appendChild(el('div','hint',cfg.hint));\n  card.appendChild(main);wrap.appendChild(card);document.body.appendChild(wrap);\n  // Segunda camada da trava: navegadores antigos ignoram touch-action.\n  stage.addEventListener('touchmove',function(e){e.preventDefault()},{passive:false});\n  document.querySelectorAll('.deck,.pills').forEach(function(n){\n    n.addEventListener('touchmove',function(e){e.preventDefault()},{passive:false})});\n  if(cfg.keys!==false)document.addEventListener('keydown',function(e){\n    var m={ArrowUp:'U',ArrowDown:'D',ArrowLeft:'L',ArrowRight:'R',KeyW:'U',KeyS:'D',KeyA:'L',KeyD:'R',Space:'A',KeyZ:'A',KeyX:'B',Enter:'START'};\n    if(m[e.code]){e.preventDefault();hold(m[e.code],1)}});\n  if(cfg.keys!==false)document.addEventListener('keyup',function(e){\n    var m={ArrowUp:'U',ArrowDown:'D',ArrowLeft:'L',ArrowRight:'R',KeyW:'U',KeyS:'D',KeyA:'L',KeyD:'R',Space:'A',KeyZ:'A',KeyX:'B',Enter:'START'};\n    if(m[e.code])hold(m[e.code],0)});\n  if(cfg.best)api.best=+(load(cfg.best)||0),api.hud(cfg.hud&&cfg.hud[cfg.hud.length-1]||'BEST',api.best);\n  return api;\n}\nfunction load(k){try{return localStorage.getItem('hz_'+k)}catch(e){return null}}\nfunction save(k,v){try{localStorage.setItem('hz_'+k,v)}catch(e){}}\napi.boot=boot;\napi.hud=function(l,v){var e=document.getElementById('hv'+l);if(e)e.textContent=v};\napi.best=0;\napi.record=function(v){if(v>api.best){api.best=v;if(C.best)save(C.best,v);\n api.hud(C.hud&&C.hud[C.hud.length-1]||'BEST',v);\n if(cx)api.part(W-40,14,'#ffd479',8,2.2);\n return 1}return 0};\napi.held=function(k){return !!held[k]};\napi.tap=function(k){var v=tap[k];tap[k]=0;return !!v};\napi.on=function(k,f){press[k]=f};\napi.over=function(t,s,btn){paused=1;api.shake(9);msg.className='msg';msg.innerHTML='<b>'+t+'</b>'+(s?'<span>'+s+'</span>':'');\n  if(btn!==false){var b=el('button','k pill',btn||'JOGAR');b.style.marginTop='10px';\n    b.addEventListener('pointerdown',function(e){e.preventDefault();if(C.start)C.start()});msg.appendChild(b)}};\napi.play=function(){msg.className='msg off';paused=0};\napi.paused=function(){return paused};\napi.loop=function(f){tickFn=f;if(!raf){prev=0;raf=requestAnimationFrame(step)}};\n// Tremida vai no `transform` do CANVAS, nao no contexto: transladar o contexto\n// deixaria uma faixa vazia na borda em todo jogo que pinta o fundo com\n// `fillRect(0,0,W,H)` em vez do `HZ.clear`.\napi.shake=function(n){shakeN=Math.max(shakeN,n||7)};\napi.part=function(x,y,c,n,v){\n for(var i=0;i<(n||10);i++){var a=Math.random()*6.2832,s=(v||2.4)*(.35+Math.random());\n  parts.push({x:x,y:y,vx:Math.cos(a)*s,vy:Math.sin(a)*s-.6,c:c||'#fff',t:1,r:1.4+Math.random()*2.2})}};\nfunction step(t){raf=requestAnimationFrame(step);\n var ms=prev?Math.min(50,t-prev):16;prev=t;var d=ms/16.667;\n if(tickFn)tickFn(d,t);\n if(cx){if(!vinh){vinh=cx.createRadialGradient(W/2,H*.45,Math.min(W,H)*.3,W/2,H*.5,Math.max(W,H)*.75);\n   vinh.addColorStop(0,'rgba(0,0,0,0)');vinh.addColorStop(.65,'rgba(0,0,0,.1)');\n   vinh.addColorStop(1,'rgba(0,0,0,.34)')}\n  cx.fillStyle=vinh;cx.fillRect(0,0,W,H)}\n if(cx&&parts.length)parts=parts.filter(function(p){\n  p.x+=p.vx*d;p.y+=p.vy*d;p.vy+=.14*d;p.t-=.028*d;\n  if(p.t<=0)return 0;\n  cx.globalAlpha=Math.min(1,p.t);cx.fillStyle=p.c;\n  cx.fillRect(p.x-p.r,p.y-p.r,p.r*2,p.r*2);cx.globalAlpha=1;return 1});\n if(shakeN>.4){shakeN*=.86;\n  if(cv)cv.style.transform='translate('+((Math.random()-.5)*shakeN).toFixed(1)+'px,'\n   +((Math.random()-.5)*shakeN).toFixed(1)+'px)'}\n else if(shakeN){shakeN=0;if(cv)cv.style.transform=''}}\napi.beep=function(f,d,type){\n  try{if(!ac)ac=new (window.AudioContext||window.webkitAudioContext)();\n  var o=ac.createOscillator(),g=ac.createGain();o.type=type||'square';o.frequency.value=f;\n  g.gain.value=.05;o.connect(g);g.connect(ac.destination);o.start();\n  g.gain.exponentialRampToValueAtTime(.001,ac.currentTime+(d||.08));o.stop(ac.currentTime+(d||.08))}catch(e){}};\nObject.defineProperty(api,'cx',{get:function(){return cx}});\nObject.defineProperty(api,'cv',{get:function(){return cv}});\nObject.defineProperty(api,'W',{get:function(){return W}});\nObject.defineProperty(api,'H',{get:function(){return H}});\n// Escurece uma cor #rrggbb por um fator. Serve para derivar o pé do gradiente\n// do fundo a partir da única cor que o jogo informa.\nfunction escuro(c,f){\n if(!/^#[0-9a-fA-F]{6}$/.test(c))return c;\n var n=parseInt(c.slice(1),16);\n return '#'+[16,8,0].map(function(s){\n  return ('0'+Math.round(((n>>s)&255)*(1-f)).toString(16)).slice(-2)}).join('')}\n// `clear` deixou de ser cor chapada: o fundo desce para uma versão mais escura\n// de si mesmo. Um jogo que só passa uma cor ganha profundidade sem saber.\napi.clear=function(c){c=c||'#080b0d';\n var g=cx.createLinearGradient(0,0,0,H);\n g.addColorStop(0,c);g.addColorStop(1,escuro(c,.42));\n cx.fillStyle=g;cx.fillRect(0,0,W,H)};\n// Chanfro de 1px em cima e embaixo: é como pixel art sombreia, e cai bem tanto\n// em tijolo e plataforma quanto em barra de HUD.\napi.box=function(x,y,w,h,c){cx.fillStyle=c;cx.fillRect(x,y,w,h);\n if(w>3&&h>3){cx.fillStyle='rgba(255,255,255,.14)';cx.fillRect(x,y,w,1);\n  cx.fillStyle='rgba(0,0,0,.2)';cx.fillRect(x,y+h-1,w,1)}};\napi.txt=function(s,x,y,c,sz,al){cx.fillStyle=c||'#fff';cx.font='800 '+(sz||14)+'px system-ui';cx.textAlign=al||'center';cx.fillText(s,x,y);cx.textAlign='left'};\n// Brilho no alto à esquerda transforma o disco chapado em esfera. Vale para\n// bola, inimigo, moeda — tudo que os jogos desenham com `circ`.\napi.circ=function(x,y,r,c){cx.fillStyle=c;cx.beginPath();cx.arc(x,y,r,0,6.284);cx.fill();\n if(r>3.5){var g=cx.createRadialGradient(x-r*.34,y-r*.34,r*.08,x,y,r);\n  g.addColorStop(0,'rgba(255,255,255,.3)');g.addColorStop(.55,'rgba(255,255,255,.06)');\n  g.addColorStop(1,'rgba(0,0,0,.16)');\n  cx.fillStyle=g;cx.beginPath();cx.arc(x,y,r,0,6.284);cx.fill()}};\n// Toque direto na tela do jogo (mira, seleção): devolve coordenadas do canvas.\napi.touch=function(f){var t=C.dom?document.getElementById('board'):cv;\n  t.addEventListener('pointerdown',function(e){e.preventDefault();\n    var r=t.getBoundingClientRect();f((e.clientX-r.left)/r.width*W,(e.clientY-r.top)/r.height*H,e)})};\napi.load=load;api.save=save;\napi.rnd=function(n){return Math.random()*n};\napi.ri=function(n){return Math.floor(Math.random()*n)};\nreturn api;})();\nvar N=8,CS=30,OX=24,OY=44,meu,dele,mtiro,dtiro,fase,dir,idx,fim,ia;\nvar NAVIOS=[[5,\"Porta-aviões\"],[4,\"Encouraçado\"],[3,\"Cruzador\"],[3,\"Submarino\"],[2,\"Destróier\"]];\nHZ.boot({titulo:\"🚢 Batalha Naval\",w:300,h:380,best:\"naval\",hud:[\"VITÓRIAS\",\"RECORDE\"],\n acts:[[\"A\",\"🔄\",\"GIRAR\"]],pills:[[\"START\",\"NOVA PARTIDA\"]],\n hint:\"Toque para posicionar (A gira) · depois toque no mar inimigo para atirar\",start:novo});\nvar vitorias=0;\nfunction vaz(){var a=[];for(var i=0;i<N*N;i++)a.push(0);return a}\nfunction novo(){meu=vaz();dele=vaz();mtiro=vaz();dtiro=vaz();\n fase=0;idx=0;dir=0;fim=0;ia={fila:[],ult:null};\n NAVIOS.forEach(function(nv,k){\n  var t=0;while(t++<400){var h=HZ.ri(2),r=HZ.ri(N),c=HZ.ri(N);\n   if(cabe(dele,r,c,nv[0],h)){poe(dele,r,c,nv[0],h,k+1);break}}});\n HZ.play()}\nHZ.on(\"START\",novo);HZ.on(\"A\",function(){dir=1-dir;HZ.beep(500,.05)});\nfunction cabe(b,r,c,t,h){\n for(var i=0;i<t;i++){var rr=r+(h?0:i),cc=c+(h?i:0);\n  if(rr>=N||cc>=N)return 0;\n  for(var dr=-1;dr<=1;dr++)for(var dc=-1;dc<=1;dc++){\n   var ar=rr+dr,ac=cc+dc;\n   if(ar>=0&&ar<N&&ac>=0&&ac<N&&b[ar*N+ac])return 0}}\n return 1}\nfunction poe(b,r,c,t,h,id){for(var i=0;i<t;i++)b[(r+(h?0:i))*N+c+(h?i:0)]=id}\nfunction afundou(b,tiros,id){\n for(var i=0;i<N*N;i++)if(b[i]==id&&!tiros[i])return 0;return 1}\nfunction acabou(b,tiros){for(var i=0;i<N*N;i++)if(b[i]&&!tiros[i])return 0;return 1}\nfunction iaAtira(){\n var i;\n if(ia.fila.length)i=ia.fila.shift();\n else{var livres=[];\n  for(var k=0;k<N*N;k++)if(!dtiro[k]&&(Math.floor(k/N)+k%N)%2==0)livres.push(k);\n  if(!livres.length)for(var k=0;k<N*N;k++)if(!dtiro[k])livres.push(k);\n  i=livres[HZ.ri(livres.length)]}\n if(i===undefined||dtiro[i]){setTimeout(iaAtira,60);return}\n dtiro[i]=1;\n if(meu[i]){HZ.beep(200,.14,\"sawtooth\");\n  var r=Math.floor(i/N),c=i%N;\n  [[0,1],[0,-1],[1,0],[-1,0]].forEach(function(d){var nr=r+d[0],nc=c+d[1];\n   if(nr>=0&&nr<N&&nc>=0&&nc<N&&!dtiro[nr*N+nc])ia.fila.push(nr*N+nc)});\n  if(acabou(meu,dtiro)){fim=2;HZ.beep(130,.5,\"sawtooth\");\n   HZ.over(\"SUA FROTA AFUNDOU\",\"O robô venceu. Vitórias suas: \"+vitorias);return}\n  setTimeout(iaAtira,420)}\n else{HZ.beep(400,.07);fase=2}}\nHZ.touch(function(x,y){if(HZ.paused()||fim)return;\n if(fase==0){\n  var c=Math.floor((x-OX)/CS),r=Math.floor((y-OY)/CS);\n  if(r<0||r>=N||c<0||c>=N)return;\n  var nv=NAVIOS[idx];\n  if(!cabe(meu,r,c,nv[0],dir)){HZ.beep(150,.1);return}\n  poe(meu,r,c,nv[0],dir,idx+1);idx++;HZ.beep(700,.07);\n  if(idx>=NAVIOS.length){fase=2;idx=0}\n  return}\n if(fase!=2)return;\n var c=Math.floor((x-OX)/CS),r=Math.floor((y-OY)/CS);\n if(r<0||r>=N||c<0||c>=N)return;var i=r*N+c;\n if(mtiro[i])return;mtiro[i]=1;\n if(dele[i]){HZ.beep(900,.12);\n  if(afundou(dele,mtiro,dele[i]))HZ.beep(1300,.2);\n  if(acabou(dele,mtiro)){vitorias++;HZ.hud(\"VITÓRIAS\",vitorias);HZ.record(vitorias);\n   fim=1;HZ.beep(1600,.4);\n   var t=mtiro.filter(function(v){return v}).length;\n   HZ.over(\"FROTA INIMIGA AFUNDADA 🏆\",\"Você venceu com \"+t+\" tiros.\")}}\n else{HZ.beep(300,.07);fase=3;setTimeout(iaAtira,380)}});\nHZ.loop(function(){var W=HZ.W,H=HZ.H;HZ.clear(\"#0d1117\");\n var mostra=fase==0?meu:dele,tiros=fase==0?dtiro:mtiro;\n HZ.txt(fase==0?\"POSICIONE: \"+NAVIOS[idx][1]+\" (\"+NAVIOS[idx][0]+\")  \"+(dir?\"↔\":\"↕\"):\"MAR INIMIGO\",\n  W/2,22,fase==0?\"#ffd479\":\"#7ee8fa\",13);\n for(var r=0;r<N;r++)for(var c=0;c<N;c++){var i=r*N+c,x=OX+c*CS,y=OY+r*CS;\n  HZ.box(x+1,y+1,CS-2,CS-2,\"#123a5e\");\n  if(fase==0&&meu[i])HZ.box(x+3,y+3,CS-6,CS-6,\"#95a5a6\");\n  if(tiros[i]){\n   if(mostra[i]){HZ.circ(x+CS/2,y+CS/2,7,\"#ff4757\");HZ.txt(\"✕\",x+CS/2,y+CS/2+4,\"#fff\",11)}\n   else HZ.circ(x+CS/2,y+CS/2,4,\"rgba(255,255,255,.4)\")}}\n for(var k=0;k<N;k++){HZ.txt(String.fromCharCode(65+k),OX+k*CS+CS/2,OY-4,\"rgba(255,255,255,.4)\",9);\n  HZ.txt(k+1,OX-10,OY+k*CS+CS/2+4,\"rgba(255,255,255,.4)\",9)}\n var y0=OY+N*CS+14;\n HZ.txt(\"SUA FROTA\",56,y0+10,\"rgba(255,255,255,.5)\",9);\n NAVIOS.forEach(function(nv,k){\n  var vivo=fase==0?k>=idx:!afundou(meu,dtiro,k+1);\n  HZ.box(12+k*54,y0+18,nv[0]*8,9,vivo?\"#2ed573\":\"#3d3d3d\")});\n HZ.txt(\"FROTA INIMIGA\",W-64,y0+10,\"rgba(255,255,255,.5)\",9);\n NAVIOS.forEach(function(nv,k){\n  var vivo=!afundou(dele,mtiro,k+1);\n  HZ.box(12+k*54,y0+34,nv[0]*8,9,vivo?\"#ff6b81\":\"#3d3d3d\")});\n});\nHZ.hud(\"VITÓRIAS\",0);novo();HZ.over(\"BATALHA NAVAL\",\"Cinco navios, posicionados por você (A gira).\\nO robô caça em xadrez e persegue o entorno de cada acerto — não é sorteio puro.\");\n</script></body>"}