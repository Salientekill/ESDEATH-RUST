);ult=esc;sel=null;HZ.beep(760,.06);vez=2;\n   hist.push({b:b.slice(),ep:ep,rq:JSON.stringify(rq)});\n   if(!legais(b,2,ep,rq).length){acaba(2);return}\n   setTimeout(roboJoga,240);return}}\n sel=(dono(b[i])==1&&m.some(function(k){return k.de==i}))?i:null});\nvar UNI={K:\"♔\",Q:\"♕\",R:\"♖\",B:\"♗\",N:\"♘\",P:\"♙\",k:\"♚\",q:\"♛\",r:\"♜\",b:\"♝\",n:\"♞\",p:\"♟\"};\nHZ.loop(function(){var W=HZ.W,H=HZ.H;HZ.clear(\"#0d1117\");\n var m=fim?[]:legais(b,1,ep,rq);\n for(var r=0;r<8;r++)for(var c=0;c<8;c++){var i=r*8+c;\n  HZ.box(OX+c*CS,OY+r*CS,CS,CS,(r+c)%2?\"#7a5c3e\":\"#e3cfae\");\n  if(ult&&(ult.de==i||ult.pa==i))HZ.box(OX+c*CS,OY+r*CS,CS,CS,\"rgba(255,212,121,.35)\");\n  if(sel===i)HZ.box(OX+c*CS,OY+r*CS,CS,CS,\"rgba(126,232,250,.5)\");\n  if(sel!==null&&m.some(function(k){return k.de==sel&&k.pa==i}))\n   HZ.circ(OX+c*CS+CS/2,OY+r*CS+CS/2,b[i]?13:6,b[i]?\"rgba(255,71,87,.42)\":\"rgba(46,213,115,.75)\");\n  var p=b[i];if(!p)continue;\n  HZ.cx.font=\"27px serif\";HZ.cx.textAlign=\"center\";\n  HZ.cx.fillStyle=br(p)?\"#fff\":\"#111\";\n  HZ.cx.fillText(UNI[p],OX+c*CS+CS/2,OY+r*CS+CS-8);HZ.cx.textAlign=\"left\"}\n var xeq=!fim&&atacada(b,acha(b,vez),3-vez);\n HZ.txt(\"IA nível \"+nivel+(xeq?\"   ⚠ XEQUE\":\"\")+\"   Vitórias: \"+vit,W/2,H-8,xeq?\"#ff6b81\":\"rgba(255,255,255,.5)\",10);\n});\nnivel=2;HZ.hud(\"VITÓRIAS\",0);novo();HZ.over(\"XADREZ\",\"Regras completas: roque, en passant, promoção e xeque-mate.\\nA IA usa minimax com poda alfa-beta e tabelas de posição.\");\n</script></body>"}