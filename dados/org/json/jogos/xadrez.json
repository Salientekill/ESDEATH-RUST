{"titulo": "♟️ Xadrez", "html": "<style>*{-webkit-tap-highlight-color:transparent;-webkit-user-select:none;user-select:none;-webkit-touch-callout:none;box-sizing:border-box;margin:0}\nhtml,body{overscroll-behavior:none;-webkit-overflow-scrolling:auto}\nbody{background:transparent;font-family:-apple-system,'Segoe UI',Roboto,Arial,sans-serif;color:#e8edf0}\n.wrap{width:100%;max-width:620px;margin:auto;padding:12px}\n.card{background:rgba(20,25,29,.985);border:1px solid rgba(255,255,255,.13);border-radius:16px;overflow:hidden;box-shadow:0 8px 34px rgba(0,0,0,.45)}\n.head{padding:10px 14px;border-bottom:1px solid rgba(255,255,255,.09);display:flex;justify-content:space-between;align-items:center;gap:10px}\n.brand{font-size:9px;letter-spacing:1.7px;color:rgba(255,255,255,.34)}\n.title{font-size:17px;font-weight:900;color:#fff;line-height:1.2}\n.hud{display:flex;gap:13px;text-align:right;flex-shrink:0}\n.lab{font-size:8px;letter-spacing:1px;color:rgba(255,255,255,.42)}\n.val{font:800 16px ui-monospace,'Courier New',monospace;color:#ffd479;white-space:nowrap}\n.main{padding:12px}\n.stage{position:relative;touch-action:none;-ms-touch-action:none}\ncanvas{display:block;width:100%;height:auto;background:#080b0d;border:1px solid rgba(255,255,255,.1);border-radius:12px;touch-action:none}\n#board{touch-action:none}\n.msg{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6px;background:rgba(5,8,10,.86);border-radius:12px;text-align:center;padding:16px}\n.msg.off{display:none}\n.msg b{font-size:19px;color:#fff;letter-spacing:.5px}\n.msg span{font-size:12px;color:rgba(255,255,255,.62);line-height:1.5;max-width:88%}\n.deck{margin-top:11px;display:flex;justify-content:space-between;align-items:center;gap:12px;touch-action:none}\n.dpad{display:grid;grid-template-columns:repeat(3,44px);grid-template-rows:repeat(3,44px);gap:5px;flex-shrink:0}\n.dpad.h{grid-template-rows:44px}\n.dpad.v{grid-template-columns:44px}\n.k{border:1px solid rgba(255,255,255,.17);background:rgba(255,255,255,.085);color:#fff;border-radius:12px;font:800 16px system-ui;display:flex;align-items:center;justify-content:center;touch-action:none;padding:0;line-height:1;transition:transform .05s,background .05s}\n.k.on{background:rgba(255,255,255,.3);transform:scale(.93)}\n.k.sp{visibility:hidden}\n.acts{display:flex;gap:9px;align-items:center;flex-wrap:wrap;justify-content:flex-end}\n.k.rd{width:62px;height:62px;border-radius:50%;font-size:15px;flex-direction:column;gap:1px}\n.k.rd small{font-size:7px;letter-spacing:.6px;opacity:.75;font-weight:700}\n.k.a{background:#d8394f;border-color:#ff7f92}\n.k.b{background:#2f6fe4;border-color:#79a5ff}\n.k.c{background:#1f9d63;border-color:#67d9a0}\n.k.d{background:#8a52d6;border-color:#b892f0}\n.pills{display:flex;gap:8px;justify-content:center;margin-top:10px;flex-wrap:wrap}\n.k.pill{padding:10px 18px;border-radius:20px;font:800 11px system-ui;letter-spacing:1.2px;min-width:78px}\n.hint{text-align:center;margin-top:9px;font-size:11px;color:rgba(255,255,255,.48);line-height:1.45}\n.grid{display:grid;gap:5px;touch-action:none}\n.cell{border:1px solid rgba(255,255,255,.12);background:rgba(255,255,255,.05);border-radius:8px;display:flex;align-items:center;justify-content:center;font-weight:800;touch-action:none}</style><body><script>var HZ=(function(){\nvar api={},C={},cv,cx,msg,hudEl,parts=[],shakeN=0,vinh=null,held={},tap={},press={},W=0,H=0,tickFn=null,raf=0,prev=0,ac=null,paused=1;\nfunction el(t,c,h){var e=document.createElement(t);if(c)e.className=c;if(h!=null)e.innerHTML=h;return e}\nfunction key(id,cls,label,sub){\n  var b=el('button','k '+cls,label+(sub?'<small>'+sub+'</small>':''));\n  b.setAttribute('type','button');\n  // Deixa o id do botao legivel de fora: a auditoria cruza isto com os\n  // `HZ.on`/`HZ.held` do jogo para achar entrada que nunca dispara.\n  b.dataset.hz=id;\n  // Trava de rolagem: sem preventDefault no pointerdown o webview do WhatsApp\n  // interpreta o ar